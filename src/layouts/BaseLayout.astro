---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Absolute or root-relative URL of the social preview image. */
	ogImage?: string;
	/** The home page opens with the glyph band and logo intro instead. */
	showHeader?: boolean;
	/** Set false when the page lays out its own main and footer (the home grid). */
	wrapMain?: boolean;
	bodyClass?: string;
}

const {
	title = site.title,
	description = site.description,
	ogImage,
	showHeader = true,
	wrapMain = true,
	bodyClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="theme-color" content="#f0eee9" />
		<Font cssVariable="--font-sora" preload />
		<Font cssVariable="--font-inter" preload />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en_GB" />
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
		<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
	</head>
	<body class={bodyClass}>
		<a class="skip-link" href="#main">Skip to content</a>
		{showHeader && <SiteHeader />}
		{
			wrapMain ? (
				<>
					<main id="main" tabindex="-1">
						<slot />
					</main>
					<SiteFooter />
				</>
			) : (
				<slot />
			)
		}
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
	}
</style>
