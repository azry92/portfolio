---
import { Font } from 'astro:assets';
import BackToTop from '../components/BackToTop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ogDefault, site, type OgImage } from '../data/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** The social preview image; site-wide default is public/og.png. */
	ogImage?: OgImage;
	/** The sticky site header; every page shows it today. */
	showHeader?: boolean;
	/** Set false when the page lays out its own main and footer (the home grid). */
	wrapMain?: boolean;
	bodyClass?: string;
	/** Keep the page out of search results (the 404); it also drops the canonical URL. */
	noindex?: boolean;
	/** Set false on a page too short for Back to top to have a purpose (home, the 404). */
	showBackToTop?: boolean;
	/** Set false to drop the footer's nav links (home). */
	showFooterNav?: boolean;
	/** The footer runs full width, like the page above it (home). */
	fullWidth?: boolean;
}

const {
	title = site.title,
	description = site.description,
	ogImage = ogDefault,
	showHeader = true,
	wrapMain = true,
	bodyClass,
	noindex = false,
	showBackToTop = true,
	showFooterNav = true,
	fullWidth = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Crawlers need an absolute URL, so this relies on `site` in astro.config.
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Set before first paint so the mobile header collapses to its Menu button without a shift. -->
		<script is:inline>document.documentElement.classList.add('js');</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<!-- The PNG is the fallback; browsers that take SVG icons use the one after it. /favicon.ico is for crawlers that ask for it directly. -->
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#f0eee9" />
		<Font cssVariable="--font-sora" preload />
		<Font cssVariable="--font-inter" preload />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:locale" content="en_GB" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content={String(ogImage.width)} />
		<meta property="og:image:height" content={String(ogImage.height)} />
		<meta property="og:image:alt" content={ogImage.alt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImage.alt} />
	</head>
	<body id="top" class={bodyClass}>
		<a class="skip-link" href="#main">Skip to content</a>
		{showHeader && <SiteHeader />}
		{
			wrapMain ? (
				<>
					<main id="main" tabindex="-1">
						<slot />
					</main>
					{showBackToTop && <BackToTop />}
					<SiteFooter showNav={showFooterNav} fullWidth={fullWidth} />
				</>
			) : (
				<slot />
			)
		}
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
	}
</style>
