---
// A row of figures. A caption for the whole row makes the row a figure.
// Phones: from 600px, one column per phone at its max width, 48px apart and centred;
// 2 per row below that, with an odd last phone centred.
// Other images: rows of 2–3 stack below 600px; rows of 4–5 go 2, then 3, then all across from 1200px.
// Uniform rows stay one row at every width.
import Figure from './Figure.astro';
import type { Frame } from '../lib/case-study/layouts';
import type { Figure as FigureData } from '../lib/case-study/parse';

interface Props {
	items: FigureData[];
	frame?: Frame;
	/** Caption HTML for the whole row. */
	caption?: string;
	/** Force a column count: 1 stacks figures in a narrow column; stage rows share their longest row's count. */
	columns?: number;
	/** Box every image in the same square, so marks of different proportions read at one size. */
	uniform?: boolean;
}

const { items, frame = 'none', caption, columns = items.length, uniform = false } = Astro.props;
const across = Math.min(columns, 5);

const sizes =
	frame === 'phone'
		? `(min-width: 1200px) 240px, (min-width: 600px) ${Math.round(100 / columns)}vw, 45vw`
		: across === 1
			? '(min-width: 1248px) 1200px, 100vw'
			: `(min-width: 1248px) ${Math.round(1200 / across)}px, (min-width: 600px) ${Math.round(100 / across)}vw, 100vw`;

const Tag = caption ? 'figure' : 'div';
---

<Tag class:list={['figure-grid', `figure-grid--${frame}`, { 'figure-grid--uniform': uniform }]} style={`--across: ${across}; --count: ${columns}`}>
	<div class="figure-grid__items" data-across={across}>
		{items.map((figure) => <Figure figure={figure} frame={frame} sizes={sizes} />)}
	</div>
	{caption && <figcaption class="figure-grid__caption" set:html={caption} />}
</Tag>

<style>
	.figure-grid {
		display: grid;
		gap: var(--space-16);
	}

	.figure-grid__items {
		--columns: 1;
		--gap-x: var(--space-24);

		display: grid;
		grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
		gap: var(--space-32) var(--gap-x);
	}

	/* Phones: 2 per row on small screens, each centred in its column at a phone's width. */
	.figure-grid--phone .figure-grid__items {
		--gap-x: var(--space-16);

		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.figure-grid--phone .figure-grid__items > :global(.figure) {
		justify-self: center;
		inline-size: 100%;
		max-inline-size: 15rem;
	}

	/* An odd last phone takes the full row, centred at one column's width. */
	.figure-grid--phone .figure-grid__items > :global(.figure:last-child:nth-child(odd)) {
		grid-column: 1 / -1;
		inline-size: calc((100% - var(--gap-x)) / 2);
	}

	.figure-grid__items[data-across='4'],
	.figure-grid__items[data-across='5'] {
		--columns: 2;
	}

	/* Captioned figures share an image row and a caption row with their neighbours,
	   so captions start on one line when the images differ in height. */
	.figure-grid:not(.figure-grid--phone) .figure-grid__items > :global(.figure:has(.figure__caption)) {
		grid-row: span 2;
		grid-template-rows: subgrid;
		row-gap: var(--space-12);
	}

	@media (min-width: 600px) {
		.figure-grid__items:not([data-across='1']) {
			--columns: min(var(--across), 3);
		}

		/* One column per phone at a phone's width, 48px apart and centred; in a narrow
		   column the phones shrink evenly so the gap holds. */
		.figure-grid--phone .figure-grid__items {
			--gap-x: var(--space-48);

			grid-template-columns: repeat(var(--count), minmax(0, 15rem));
			justify-content: center;
		}

		.figure-grid--phone .figure-grid__items > :global(.figure:last-child:nth-child(odd)) {
			grid-column: auto;
			inline-size: 100%;
		}
	}

	@media (min-width: 1200px) {
		.figure-grid__items:not([data-across='1']) {
			--columns: var(--across);
		}
	}

	/* Uniform rows ("… in a row, same size") stay one row at every width, every image
	   on the same square tile whatever its own proportions. On small screens the gap
	   and padding tighten so each mark fills most of its tile. */
	.figure-grid--uniform .figure-grid__items {
		--gap-x: var(--space-12);

		grid-template-columns: repeat(var(--across), minmax(0, 1fr));
	}

	.figure-grid--uniform .figure-grid__items :global(.figure__image) {
		aspect-ratio: 1;
		padding: var(--space-8);
		border: var(--border-width) solid var(--color-border);
		background-color: var(--color-surface);
		object-fit: contain;
	}

	@media (min-width: 600px) {
		.figure-grid--uniform .figure-grid__items {
			--gap-x: var(--space-24);
		}

		.figure-grid--uniform .figure-grid__items :global(.figure__image) {
			padding: var(--space-24);
		}
	}

	.figure-grid__caption {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	.figure-grid--phone .figure-grid__caption {
		text-align: center;
	}
</style>
