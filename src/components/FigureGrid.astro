---
// A row of figures. A caption for the whole row makes the row a figure.
// Phones: one equal column per phone from 600px, each centred at a max width;
// 2 per row below that, with an odd last phone centred.
// Other images: rows of 2–3 stack below 600px; rows of 4–5 go 2, then 3, then all across from 1200px.
import Figure from './Figure.astro';
import type { Frame } from '../lib/case-study/layouts';
import type { Figure as FigureData } from '../lib/case-study/parse';

interface Props {
	items: FigureData[];
	frame?: Frame;
	/** Caption HTML for the whole row. */
	caption?: string;
	/** Force a column count: 1 stacks figures in a narrow column; stage rows share their longest row's count. */
	columns?: number;
}

const { items, frame = 'none', caption, columns = items.length } = Astro.props;
const across = Math.min(columns, 5);

const sizes =
	frame === 'phone'
		? `(min-width: 1200px) 240px, (min-width: 600px) ${Math.round(100 / columns)}vw, 45vw`
		: across === 1
			? '(min-width: 1248px) 1200px, 100vw'
			: `(min-width: 1248px) ${Math.round(1200 / across)}px, (min-width: 600px) ${Math.round(100 / across)}vw, 100vw`;

const Tag = caption ? 'figure' : 'div';
---

<Tag class:list={['figure-grid', `figure-grid--${frame}`]} style={`--across: ${across}; --count: ${columns}`}>
	<div class="figure-grid__items" data-across={across}>
		{items.map((figure) => <Figure figure={figure} frame={frame} sizes={sizes} />)}
	</div>
	{caption && <figcaption class="figure-grid__caption" set:html={caption} />}
</Tag>

<style>
	.figure-grid {
		display: grid;
		gap: var(--space-16);
	}

	.figure-grid__items {
		--columns: 1;
		--gap-x: var(--space-24);

		display: grid;
		grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
		gap: var(--space-32) var(--gap-x);
	}

	/* Phones: 2 per row on small screens, each centred in its column at a phone's width. */
	.figure-grid--phone .figure-grid__items {
		--gap-x: var(--space-16);

		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.figure-grid--phone .figure-grid__items > :global(.figure) {
		justify-self: center;
		inline-size: 100%;
		max-inline-size: 15rem;
	}

	/* An odd last phone takes the full row, centred at one column's width. */
	.figure-grid--phone .figure-grid__items > :global(.figure:last-child:nth-child(odd)) {
		grid-column: 1 / -1;
		inline-size: calc((100% - var(--gap-x)) / 2);
	}

	.figure-grid__items[data-across='4'],
	.figure-grid__items[data-across='5'] {
		--columns: 2;
	}

	@media (min-width: 600px) {
		.figure-grid__items:not([data-across='1']) {
			--columns: min(var(--across), 3);
		}

		/* One equal column per phone across the full content width. */
		.figure-grid--phone .figure-grid__items {
			--gap-x: var(--space-24);

			grid-template-columns: repeat(var(--count), minmax(0, 1fr));
		}

		.figure-grid--phone .figure-grid__items > :global(.figure:last-child:nth-child(odd)) {
			grid-column: auto;
			inline-size: 100%;
		}
	}

	@media (min-width: 1200px) {
		.figure-grid__items:not([data-across='1']) {
			--columns: var(--across);
		}
	}

	.figure-grid__caption {
		font-size: var(--text-14);
	}

	.figure-grid--phone .figure-grid__caption {
		text-align: center;
	}
</style>
