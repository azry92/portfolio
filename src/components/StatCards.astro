---
// Figures as cards, the first one largest: two columns with the first across both
// (and an odd last card too), and from 1200px the first beside the others stacked.
// Below 600px the paired cards tighten so their figures fit half a phone's width.
import type { Stat } from '../lib/case-study/parse';

interface Props {
	items: Stat[];
}

const { items } = Astro.props;

// Screen readers can read "6m 2s" as metres; spell out durations for them.
const units: Record<string, string> = { h: 'hour', m: 'minute', s: 'second' };
const spoken = (value: string) =>
	value.replace(/(\d+)([hms])\b/g, (_, n: string, unit: string) => `${n} ${units[unit]}${n === '1' ? '' : 's'}`);
---

<ul class="stat-cards" role="list" style={`--rest: ${Math.max(items.length - 1, 1)}`}>
	{
		items.map((stat) => (
			<li class="stat-card">
				<p class="stat-card__value">
					{spoken(stat.value) === stat.value ? (
						stat.value
					) : (
						<>
							<span aria-hidden="true">{stat.value}</span>
							<span class="visually-hidden">{spoken(stat.value)}</span>
						</>
					)}
				</p>
				<p class="stat-card__label" set:html={stat.label} />
			</li>
		))
	}
</ul>

<style>
	.stat-cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-16);
		padding: 0;
		list-style: none;
	}

	.stat-card {
		display: grid;
		gap: var(--space-8);
		align-content: start;
		padding: var(--space-16);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-sm);
		background-color: var(--color-surface);
	}

	.stat-card__value {
		font-family: var(--font-display);
		font-size: var(--text-32);
		font-weight: var(--weight-bold);
		line-height: 1;
	}

	.stat-card__label {
		max-inline-size: 32ch;
	}

	.stat-card:first-child .stat-card__value {
		font-size: var(--text-48);
	}

	/* An odd card left after the lead takes the full row, so no cell sits empty. */
	.stat-card:first-child,
	.stat-card:last-child:nth-child(even) {
		grid-column: 1 / -1;
	}

	.stat-card:first-child {
		padding: var(--space-24);
	}

	@media (min-width: 600px) {
		.stat-card {
			padding: var(--space-24);
		}

		.stat-card__value {
			font-size: var(--text-40);
		}
	}

	@media (min-width: 1200px) {
		.stat-cards {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			gap: var(--space-24);
		}

		/* The lead card takes the left column, as tall as the others stacked on the right. */
		.stat-card:first-child {
			grid-column: 1;
			grid-row: 1 / span var(--rest);
			align-content: center;
			padding: var(--space-48);
		}

		.stat-card:last-child:nth-child(even) {
			grid-column: 2;
		}

		.stat-card:first-child .stat-card__value {
			font-size: var(--text-64);
		}

		.stat-card:first-child .stat-card__label {
			font-size: var(--text-18);
		}
	}
</style>
