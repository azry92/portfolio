---
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" data-site-header>
	<div class="container container--full site-header__inner">
		<a class="site-header__name" href="/">{site.name}</a>
		<button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
		<nav id="site-nav" class="site-header__panel" aria-label="Primary">
			<ul class="site-header__nav" role="list">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								target={item.newTab ? '_blank' : undefined}
								rel={item.newTab ? 'noopener' : undefined}
								aria-label={item.ariaLabel}
								aria-current={item.href === path ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	import '../scripts/site-menu';
	import '../scripts/header-autohide';
</script>

<style>
	/* Sticky on every page so Work, Contact and the CV are one tap away at any depth.
	   global.css offsets anchor jumps by --header-h so headings don't land under it. */
	.site-header {
		position: sticky;
		inset-block-start: 0;
		z-index: 10;
		background-color: var(--color-bg);
		border-block-end: 1px solid var(--color-border);
	}

	.site-header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-8) var(--space-24);
		/* With the links' own 8px, about 24px of air above and below the text. */
		padding-block: var(--space-16);
	}

	.site-header__name {
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: var(--text-18);
		font-weight: var(--weight-bold);
		text-decoration: none;
	}

	/* Without JS the button does nothing, so it stays out and the links wrap under the name. */
	.site-header__toggle {
		display: none;
	}

	/* Without JS the six links wrap under the name; from 600px they fit one line beside it. */
	.site-header__nav {
		display: flex;
		gap: var(--space-16);
		padding: 0;
		list-style: none;
	}

	/* Padded like the footer nav for a taller tap target; the bar's padding allows for it. */
	.site-header__nav a {
		display: inline-block;
		padding-block: var(--space-8);
		color: var(--color-text);
		font-weight: var(--weight-semibold);
		text-decoration: none;
	}

	/* Below 600px with JS: one 56px bar (the rule included), the nav in a full-width panel. */
	@media (max-width: 599.98px) {
		:global(.js) .site-header {
			block-size: 3.5rem;
		}

		:global(.js) .site-header__inner {
			flex-wrap: nowrap;
			block-size: 100%;
			padding-block: 0;
		}

		/* A compact .button-square: square, 1px border, the fill inverts on focus and hover. */
		:global(.js) .site-header__toggle {
			display: inline-flex;
			align-items: center;
			min-block-size: 2.5rem;
			padding-inline: var(--space-12);
			border: var(--border-width) solid currentColor;
			border-radius: 0;
			background-color: transparent;
			color: var(--color-text);
			cursor: pointer;
			font-weight: var(--weight-semibold);
			line-height: var(--leading-heading);
		}

		:global(.js) .site-header__toggle:focus-visible {
			background-color: var(--color-surface-inverse);
			color: var(--color-text-inverse);
		}

		/* header-autohide.ts sets it while scrolling down; the translate covers the rule too. */
		:global(.js) .site-header[data-hidden] {
			transform: translateY(-100%);
		}

		:global(.js) .site-header__panel {
			display: none;
			position: absolute;
			inset-block-start: 100%;
			inset-inline: 0;
			padding-inline: var(--page-gutter);
			background-color: var(--color-bg);
			border-block-end: 1px solid var(--color-border);
		}

		:global(.js) .site-header[data-open] .site-header__panel {
			display: block;
		}

		:global(.js) .site-header__nav {
			flex-direction: column;
			gap: 0;
		}

		/* Hairlines between rows only. */
		:global(.js) .site-header__nav li + li {
			border-block-start: 1px solid var(--color-border);
		}

		:global(.js) .site-header__nav a {
			display: flex;
			align-items: center;
			min-block-size: var(--space-48);
		}
	}

	@media (max-width: 599.98px) and (hover: hover) {
		:global(.js) .site-header__toggle:hover {
			background-color: var(--color-surface-inverse);
			color: var(--color-text-inverse);
		}
	}

	@media (min-width: 600px) {
		.site-header__nav {
			gap: var(--space-24);
		}
	}

	.site-header__nav a:hover,
	.site-header__nav a[aria-current='page'] {
		color: var(--color-accent);
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-header__nav a {
			transition: color 150ms ease-out;
		}
	}

	/* Only the slide eases; with reduced motion it shows or hides at once. */
	@media (max-width: 599.98px) and (prefers-reduced-motion: no-preference) {
		:global(.js) .site-header {
			transition: transform 200ms ease-out;
		}
	}
</style>
