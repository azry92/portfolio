---
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
	<div class="container container--full site-header__inner">
		<a class="site-header__name" href="/">{site.name}</a>
		<nav aria-label="Primary">
			<ul class="site-header__nav" role="list">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								target={item.newTab ? '_blank' : undefined}
								rel={item.newTab ? 'noopener' : undefined}
								aria-label={item.ariaLabel}
								aria-current={item.href === path ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	/* Sticky on every page so Work, Contact and the CV are one tap away at any depth.
	   global.css offsets anchor jumps by --header-h so headings don't land under it. */
	.site-header {
		position: sticky;
		inset-block-start: 0;
		z-index: 10;
		background-color: var(--color-bg);
		border-block-end: 1px solid var(--color-border);
	}

	.site-header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-8) var(--space-24);
		/* With the links' own 8px, about 24px of air above and below the text. */
		padding-block: var(--space-16);
	}

	.site-header__name {
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: var(--text-18);
		font-weight: var(--weight-bold);
		text-decoration: none;
	}

	/* Five links fit one line at 360px with the 16px gap; the name wraps above them. */
	.site-header__nav {
		display: flex;
		gap: var(--space-16);
		padding: 0;
		list-style: none;
	}

	/* Padded like the footer nav for a taller tap target; the bar's padding allows for it. */
	.site-header__nav a {
		display: inline-block;
		padding-block: var(--space-8);
		color: var(--color-text);
		font-weight: var(--weight-semibold);
		text-decoration: none;
	}

	@media (min-width: 600px) {
		.site-header__nav {
			gap: var(--space-24);
		}
	}

	.site-header__nav a:hover,
	.site-header__nav a[aria-current='page'] {
		color: var(--color-accent);
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-header__nav a {
			transition: color 150ms ease-out;
		}
	}
</style>
