---
// One image from a project, in a phone, browser or head-unit frame or on its own, with an optional caption.
import { Picture } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import DisplayFrame from './DisplayFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import ZoomLink from './ZoomLink.astro';
import type { Frame } from '../lib/case-study/layouts';
import type { Figure } from '../lib/case-study/parse';

interface Props {
	figure: Figure;
	frame?: Frame;
	sizes: string;
}

const { figure, frame = 'none', sizes } = Astro.props;
const { image, alt, caption } = figure;
const widths = (frame === 'phone' ? [240, 360, 540, 720] : [480, 960, 1440, 1920]).filter((w) => w <= image.width);
// SVG diagrams go out as they are; there is nothing to gain from rasterising them.
const isSvg = image.format === 'svg';
---

<figure class:list={['figure', `figure--${frame}`]}>
	{
		frame === 'phone' ? (
			<PhoneFrame>
				<ZoomLink image={image}>
					<Picture src={image} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} />
				</ZoomLink>
			</PhoneFrame>
		) : frame === 'browser' ? (
			<BrowserFrame>
				<ZoomLink image={image}>
					<Picture src={image} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} />
				</ZoomLink>
			</BrowserFrame>
		) : frame === 'display' ? (
			<DisplayFrame>
				<ZoomLink image={image}>
					<Picture src={image} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} />
				</ZoomLink>
			</DisplayFrame>
		) : isSvg ? (
			<ZoomLink image={image}>
				<img class="figure__image" src={image.src} width={image.width} height={image.height} alt={alt} loading="lazy" decoding="async" />
			</ZoomLink>
		) : (
			<ZoomLink image={image}>
				<Picture class="figure__image" src={image} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} />
			</ZoomLink>
		)
	}
	{caption && <figcaption class="figure__caption" set:html={caption} />}
</figure>

<style>
	.figure {
		display: grid;
		gap: var(--space-12);
		align-content: start;
	}

	/* The class lands on the <img> inside <Picture>, outside this component's scope. */
	.figure :global(.figure__image) {
		inline-size: 100%;
		block-size: auto;
		border-radius: var(--radius-sm);
	}

	.figure__caption {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	.figure--phone .figure__caption {
		text-align: center;
	}
</style>
