---
// The case study's opening on the page cream: title, at-a-glance lines, project facts,
// the overview and the hero image, placed on the 12-column grid.
// Below 600px the image sits between the glance and the overview, so the first screen
// shows the title, the outcome and the work. From 600px it follows the copy. From 1200px
// the title takes columns 1 to 8 with the facts in 9 to 12, then the overview (01) in 1 to 5
// beside the image in 7 to 12.
// By default the cover goes in unframed, since it carries its own mockup. With a `hero`
// field the image sits in a browser or phone frame.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BrowserFrame from './BrowserFrame.astro';
import CaseStudyGlance from './CaseStudyGlance.astro';
import CaseStudyMeta from './CaseStudyMeta.astro';
import PhoneFrame from './PhoneFrame.astro';
import Prose from './Prose.astro';
import SectionLabel from './SectionLabel.astro';
import type { Section } from '../lib/case-study/parse';

interface Props {
	entry: CollectionEntry<'caseStudies'>;
	overview: Section;
	/** Id of the Results heading, for the glance block's link. */
	resultsId?: string;
}

const { entry, overview, resultsId } = Astro.props;
const { title, glance, client, role, team, timeline, platform, tools, live_url, cover, cover_alt, hero } = entry.data;
---

<header class="hero">
	<div class="hero__inner container">
		<div class="hero__lead">
			<h1 class="hero__title">{title}</h1>
			{glance && <CaseStudyGlance {...glance} resultsId={resultsId} />}
		</div>
		{
			hero ? (
				<div class:list={['hero__media', `hero__media--${hero.frame}`]}>
					{hero.frame === 'browser' ? (
						<BrowserFrame
							src={hero.image}
							alt={hero.alt}
							widths={[480, 720, 960, 1440, 1920]}
							sizes="(min-width: 1248px) 576px, (min-width: 1200px) 48vw, 100vw"
							loading="eager"
							fetchpriority="high"
						/>
					) : (
						<PhoneFrame src={hero.image} alt={hero.alt} sizes="240px" loading="eager" fetchpriority="high" />
					)}
				</div>
			) : (
				<div class="hero__media hero__cover">
					<Picture
						src={cover}
						alt={cover_alt}
						formats={['avif', 'webp']}
						widths={[480, 720, 960, 1440, 1920].filter((w) => w <= cover.width)}
						sizes="(min-width: 1248px) 576px, (min-width: 1200px) 48vw, 100vw"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			)
		}
		<section class="hero__overview" aria-labelledby={overview.id}>
			<div class="hero__overview-header">
				<SectionLabel number={1} marker="var(--accent)" />
				<h2 id={overview.id}>{overview.heading}</h2>
			</div>
			{overview.blocks.map((block) => block.kind === 'prose' && <Prose html={block.html} />)}
		</section>
		<div class="hero__meta">
			<CaseStudyMeta client={client} role={role} team={team} timeline={timeline} platform={platform} tools={tools} liveUrl={live_url} />
		</div>
	</div>
</header>

<style>
	.hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: 'lead' 'media' 'overview' 'meta';
		gap: var(--space-32) var(--gutter);
		padding-block: var(--space-48);
	}

	.hero__lead {
		display: grid;
		gap: var(--space-32);
		align-content: start;
		grid-area: lead;
	}

	.hero__media {
		grid-area: media;
	}

	.hero__overview {
		display: grid;
		gap: var(--space-16);
		align-content: start;
		grid-area: overview;
	}

	.hero__meta {
		grid-area: meta;
	}

	.hero__title {
		font-size: var(--text-display);
		letter-spacing: -0.01em;
	}

	.hero__overview-header {
		display: grid;
		gap: var(--space-12);
	}

	.hero__overview h2 {
		font-size: var(--text-24);
	}

	.hero__cover :global(img) {
		inline-size: 100%;
		block-size: auto;
	}

	.hero__media--phone :global(.phone) {
		inline-size: min(100%, 15rem);
	}

	@media (min-width: 600px) {
		.hero__inner {
			grid-template-areas: 'lead' 'overview' 'meta' 'media';
			padding-block: var(--space-64);
		}
	}

	@media (min-width: 1200px) {
		.hero__inner {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-areas: none;
			row-gap: var(--space-64);
		}

		.hero__lead {
			grid-area: 1 / 1 / 2 / span 8;
		}

		.hero__meta {
			grid-area: 1 / 9 / 2 / -1;
		}

		.hero__overview {
			grid-area: 2 / 1 / 3 / span 5;
		}

		.hero__media {
			grid-area: 2 / 7 / 3 / -1;
		}
	}
</style>
