---
// "Vertical stack of homepage sections, labelled …": one run of screenshots split
// evenly, in order, under the labels. Each label's screenshots sit together in one
// browser window, as consecutive sections of the same page.
import { Picture } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import ZoomLink from './ZoomLink.astro';
import type { Block } from '../lib/case-study/parse';

interface Props {
	labels: string[];
	run: Extract<Block, { kind: 'figures' }>;
}

const { labels, run } = Astro.props;
const per = run.items.length / labels.length;
if (!Number.isInteger(per)) {
	throw new Error(`"labelled ${labels.join(' / ')}" needs a multiple of ${labels.length} images, got ${run.items.length}`);
}
const groups = labels.map((label, i) => ({ label, items: run.items.slice(i * per, (i + 1) * per) }));
const Tag = run.caption ? 'figure' : 'div';
---

<Tag class="labelled-stack">
	<ol class="labelled-stack__list" role="list">
		{
			groups.map((group) => (
				<li class="labelled-stack__item">
					<h4 class="labelled-stack__label">{group.label}</h4>
					<BrowserFrame>
						{group.items.map((item) => (
							<ZoomLink image={item.image}>
								<Picture
									src={item.image}
									alt={item.alt}
									formats={['avif', 'webp']}
									widths={[480, 960, 1440, 1920].filter((w) => w <= item.image.width)}
									sizes="(min-width: 1248px) 960px, 100vw"
								/>
							</ZoomLink>
						))}
					</BrowserFrame>
				</li>
			))
		}
	</ol>
	{run.caption && <figcaption class="labelled-stack__caption" set:html={run.caption} />}
</Tag>

<style>
	.labelled-stack {
		display: grid;
		gap: var(--space-16);
	}

	.labelled-stack__list {
		display: grid;
		gap: var(--space-32);
		padding: 0;
		list-style: none;
	}

	.labelled-stack__item {
		display: grid;
		gap: var(--space-12);
	}

	.labelled-stack__label {
		font-size: var(--text-18);
	}

	.labelled-stack__caption {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	@media (min-width: 1200px) {
		/* Label in a narrow column beside its window. */
		.labelled-stack__item {
			grid-template-columns: 10rem minmax(0, 1fr);
			gap: var(--space-32);
			align-items: start;
		}

		.labelled-stack__label {
			font-size: var(--text-24);
		}

		.labelled-stack__caption {
			padding-inline-start: calc(10rem + var(--space-32));
		}
	}
</style>
