---
// "Vertical stack of homepage sections, labelled …": one run of screenshots split
// evenly, in order, under the labels. Each screenshot sits in its own browser
// window; a label's windows go two across from 768px, one column below.
import Figure from './Figure.astro';
import type { Block } from '../lib/case-study/parse';

interface Props {
	labels: string[];
	run: Extract<Block, { kind: 'figures' }>;
}

const { labels, run } = Astro.props;
const per = run.items.length / labels.length;
if (!Number.isInteger(per)) {
	throw new Error(`"labelled ${labels.join(' / ')}" needs a multiple of ${labels.length} images, got ${run.items.length}`);
}
const groups = labels.map((label, i) => ({ label, items: run.items.slice(i * per, (i + 1) * per) }));
const Tag = run.caption ? 'figure' : 'div';
---

<Tag class="labelled-stack">
	<ol class="labelled-stack__list" role="list">
		{
			groups.map((group) => (
				<li class="labelled-stack__item">
					<h4 class="labelled-stack__label">{group.label}</h4>
					<div class="labelled-stack__figures">
						{group.items.map((item) => (
							<Figure figure={item} frame="browser" sizes="(min-width: 1248px) 588px, (min-width: 768px) 50vw, 100vw" />
						))}
					</div>
				</li>
			))
		}
	</ol>
	{run.caption && <figcaption class="labelled-stack__caption" set:html={run.caption} />}
</Tag>

<style>
	.labelled-stack {
		display: grid;
		gap: var(--space-16);
	}

	.labelled-stack__list {
		display: grid;
		gap: var(--space-64);
		padding: 0;
		list-style: none;
	}

	.labelled-stack__item {
		display: grid;
		gap: var(--space-16);
	}

	.labelled-stack__label {
		font-size: var(--text-18);
	}

	.labelled-stack__figures {
		display: grid;
		gap: var(--space-24);
		align-items: start;
	}

	.labelled-stack__caption {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	@media (min-width: 768px) {
		.labelled-stack__figures {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1200px) {
		.labelled-stack__label {
			font-size: var(--text-24);
		}
	}
</style>
