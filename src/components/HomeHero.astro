---
// Home hero: role and availability on top, the short about with the two calls to
// action, then the name and claim as the page h1 across the bottom of the first screen.
// The h1 comes first in the markup, so a screen reader hears the name before the about;
// grid rows put it back at the bottom. It holds no links, so tab order is unchanged.
import GlyphTexture from './GlyphTexture.astro';
import { intro, site } from '../data/site';

// Keep "e-commerce" whole: browsers otherwise break inside.
const aboutParts = intro.about.split(/(e-commerce)/);
// On a phone the role wraps after its comma, not inside "Web & E-commerce".
const [role, field] = intro.title.split(', ');
---

<section class="hero" aria-labelledby="home-title">
	<GlyphTexture />
	<div class="container container--full hero__inner grid-12">
		<h1 id="home-title" class="hero__title">
			<span class="hero__name">{intro.name}</span>
			<span class="hero__claim">{intro.claim}</span>
		</h1>
		<div class="hero__top grid-12">
			<p class="hero__label">{role}, <span class="hero__nowrap">{field}</span></p>
			<p class="hero__label hero__status">
				<span class="hero__dot" aria-hidden="true"></span>{intro.status}
			</p>
		</div>
		<div class="hero__intro">
			<p class="hero__about">
				{aboutParts.map((part) => (part === 'e-commerce' ? <span class="hero__nowrap">{part}</span> : part))}
			</p>
			<div class="hero__actions">
				<a class="button-primary" href="#work">{intro.cta} <span aria-hidden="true">↓</span></a>
				<a class="hero__cv" href={site.cv} download>{intro.cv} <span aria-hidden="true">↓</span></a>
			</div>
			<p class="hero__current">
				{intro.current.before}<a href={intro.current.href}>{intro.current.link}</a>{intro.current.after}
			</p>
		</div>
	</div>
</section>

<style>
	/* Fills the first screen under the sticky header: labels at the top, the intro in
	   the middle, the headline on the bottom edge. Everything sits on the page grid. */
	.hero {
		position: relative;
		isolation: isolate;
		display: flex;
		min-block-size: calc(100svh - var(--header-h));
		overflow: hidden;
	}

	.hero__inner {
		grid-template-rows: auto 1fr auto;
		row-gap: var(--space-48);
		padding-block: var(--space-24) var(--space-32);
	}

	.hero__top {
		grid-row: 1;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		row-gap: var(--space-8);
	}

	.hero__label {
		font-size: var(--text-14);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.hero__dot {
		display: inline-block;
		inline-size: 0.6em;
		block-size: 0.6em;
		margin-inline-end: 0.5em;
		border-radius: var(--radius-pill);
		background-color: var(--color-status);
	}

	.hero__intro {
		grid-row: 2;
		align-self: end;
		max-inline-size: var(--measure);
	}

	.hero__about {
		font-size: var(--text-18);
	}

	.hero__nowrap {
		white-space: nowrap;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-16) var(--space-24);
		margin-block-start: var(--space-24);
	}

	.hero__cv {
		color: var(--color-text);
		font-weight: var(--weight-semibold);
	}

	.hero__current {
		margin-block-start: var(--space-24);
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	/* The largest text on the site: name in black, the claim under it in the accent. */
	.hero__title {
		grid-row: 3;
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		line-height: 0.95;
		letter-spacing: -0.02em;
	}

	.hero__name,
	.hero__claim {
		display: block;
	}

	.hero__name {
		font-size: var(--text-hero);
	}

	/* 32px at 360px wide to 80px at 1440px. */
	.hero__claim {
		margin-block-start: var(--space-8);
		color: var(--color-accent);
		font-size: clamp(var(--text-32), 1rem + 4.44vw, var(--text-80));
		line-height: 1;
		/* Breaks after "stores," at every width rather than wherever the line runs out. */
		text-wrap: balance;
	}

	@media (hover: hover) {
		.hero__cv:hover {
			color: var(--color-accent);
		}
	}

	/* From 900px the labels split the grid in half and the intro takes columns 7 to 12,
	   so the status label and the intro share one left edge. */
	@media (min-width: 900px) {
		.hero__top > :first-child {
			grid-column: 1 / span 6;
		}

		.hero__status {
			grid-column: 7 / -1;
		}

		.hero__intro {
			grid-column: 7 / -1;
		}

		.hero__title {
			grid-column: 1 / -1;
		}
	}
</style>
