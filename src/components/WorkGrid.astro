---
// "See the Work": a hairline, the numbered label and heading, the case study cards in
// frontmatter order, then Other Works and Fun as text-link rows.
import { getCollection } from 'astro:content';
import SectionLabel from './SectionLabel.astro';
import WorkCard from './WorkCard.astro';
import ShortCard from './ShortCard.astro';
import { work } from '../data/site';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="work section-rule grid-12" aria-labelledby="work-title">
	<div class="work__header">
		<SectionLabel number={1} label={work.label} />
		<h2 id="work-title" class="work__heading">{work.heading}</h2>
	</div>
	<ul class="work__cases" role="list">
		{
			caseStudies.map((entry) => (
				<li>
					<WorkCard entry={entry} />
				</li>
			))
		}
	</ul>
	<ul class="work__more" role="list">
		{
			work.more.map((item) => (
				<li>
					<ShortCard {...item} />
				</li>
			))
		}
	</ul>
</section>

<style>
	.work__cases,
	.work__more {
		padding: 0;
		list-style: none;
	}

	.work {
		row-gap: var(--space-24);
		padding-block-start: var(--space-48);
	}

	.work__heading {
		margin-block-start: var(--space-8);
		font-size: var(--text-section);
	}

	/* Below 600px: one row per case study, hairlines between the rows. */
	.work__cases > li + li {
		margin-block-start: var(--space-16);
		padding-block-start: var(--space-16);
		border-block-start: var(--rule);
	}

	/* Other Works and Fun: one text link per row, a hairline above each. */
	.work__more > li {
		border-block-start: var(--rule);
	}

	.work__more :global(.short-card) {
		display: flex;
		justify-content: space-between;
		inline-size: 100%;
		padding-block: var(--space-16);
		font-family: var(--font-display);
		font-size: var(--text-18);
	}

	/* From 600px the three cards share one row; the hairlines between them go. */
	@media (min-width: 600px) {
		.work {
			row-gap: var(--space-32);
			padding-block-start: var(--space-64);
		}

		.work__cases {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--gutter);
		}

		.work__cases > li + li {
			margin-block-start: 0;
			padding-block-start: 0;
			border: 0;
		}

		.work__more :global(.short-card) {
			font-size: var(--text-24);
		}
	}

	/* From 900px each card takes four of the twelve columns, and the two links sit
	   under the second and third cards. */
	@media (min-width: 900px) {
		.work__cases {
			grid-template-columns: subgrid;
		}

		.work__cases > li {
			grid-column: span 4;
		}

		.work__more {
			grid-column: 5 / -1;
		}
	}
</style>
