---
// An Other Works page opens with its title, the project label, the overview and one
// row of project facts, beside or above the cover. `photo` sets the cover as it is,
// running out to the right edge from 1200px (Atlas). `stage` sets the cover, a mockup
// with its own browser chrome, across the top of a black band, with the live site as
// a text link (MBFW).
// Below 600px the cover sits under the title, so the first screen shows the work.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CaseStudyMeta from './CaseStudyMeta.astro';
import Prose from './Prose.astro';
import SectionLabel from './SectionLabel.astro';
import type { Section } from '../lib/case-study/parse';

interface Props {
	entry: CollectionEntry<'otherWorks'>;
	overview: Section;
	variant: 'photo' | 'stage';
}

const { entry, overview, variant } = Astro.props;
const { title, client, project, role, team, timeline, platform, tools, live_url, cover, cover_alt } = entry.data;
---

<header class:list={['ow-hero', `ow-hero--${variant}`]}>
	<div class="ow-hero__inner container">
		<div class="ow-hero__lead">
			<h1 class="ow-hero__title">{title}</h1>
			{overview.label && <p class="ow-hero__label">{overview.label}</p>}
		</div>
		{
			variant === 'photo' ? (
				<div class="ow-hero__media">
					<Picture
						src={cover}
						alt={cover_alt}
						formats={['avif', 'webp']}
						widths={[480, 720, 960, 1400].filter((w) => w <= cover.width)}
						sizes="(min-width: 1200px) 60vw, 100vw"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			) : (
				<div class="ow-hero__media ow-hero__stage">
					<Picture
						class="ow-hero__mockup"
						src={cover}
						alt={cover_alt}
						formats={['avif', 'webp']}
						widths={[480, 720, 960, 1440, 1920].filter((w) => w <= cover.width)}
						sizes="(min-width: 1200px) 1000px, 100vw"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			)
		}
		<section class="ow-hero__overview" aria-labelledby={overview.id}>
			<div class="ow-hero__overview-header">
				<SectionLabel number={1} />
				<h2 id={overview.id}>{overview.heading}</h2>
			</div>
			{overview.blocks.map((block) => block.kind === 'prose' && <Prose html={block.html} />)}
			{
				live_url && (
					<p class="ow-hero__live">
						<a class="link-arrow" href={live_url}>
							Visit the live site <span class="link-arrow__arrow" aria-hidden="true">→</span>
						</a>
					</p>
				)
			}
		</section>
		<div class="ow-hero__meta">
			<CaseStudyMeta
				client={client}
				project={project}
				role={role}
				team={team}
				timeline={timeline}
				platform={platform}
				tools={tools}
				layout="row"
			/>
		</div>
	</div>
</header>

<style>
	.ow-hero__inner {
		display: grid;
		grid-template-areas: 'lead' 'media' 'overview' 'meta';
		gap: var(--space-32);
		padding-block: var(--space-48) var(--space-32);
	}

	.ow-hero__lead {
		grid-area: lead;
		display: grid;
		gap: var(--space-12);
	}

	.ow-hero__title {
		font-size: var(--text-display);
	}

	.ow-hero__label {
		color: var(--color-text-muted);
		font-weight: var(--weight-semibold);
	}

	.ow-hero__media {
		grid-area: media;
	}

	.ow-hero__overview {
		grid-area: overview;
		display: grid;
		gap: var(--space-16);
		align-content: start;
	}

	.ow-hero__overview-header {
		display: grid;
		gap: var(--space-12);
	}

	.ow-hero__overview h2 {
		font-size: var(--text-24);
	}

	.ow-hero__live {
		padding-block-start: var(--space-8);
	}

	.ow-hero__meta {
		grid-area: meta;
	}

	/* Photo: inside the gutter on phones, out to the screen edges from 600px. */
	.ow-hero--photo .ow-hero__media :global(img) {
		inline-size: 100%;
		block-size: auto;
		border-radius: var(--radius-sm);
	}

	@media (min-width: 600px) and (max-width: 1199.98px) {
		.ow-hero--photo .ow-hero__media {
			margin-inline: calc(var(--page-gutter) * -1);
		}

		.ow-hero--photo .ow-hero__media :global(img) {
			border-radius: 0;
		}
	}

	/* Stage: a black band runs behind the mockup's lower half and on under it, out to
	   the screen edges (html clips the overflow). */
	.ow-hero__stage {
		position: relative;
		isolation: isolate;
		padding-block-end: var(--space-32);
	}

	.ow-hero__stage :global(.ow-hero__mockup) {
		inline-size: 100%;
		block-size: auto;
		border-radius: var(--radius-sm);
	}

	.ow-hero__stage::before {
		content: '';
		position: absolute;
		inset-block: 45% 0;
		inset-inline: calc(50% - 50vw);
		z-index: -1;
		background-color: var(--color-surface-inverse);
	}

	/* Below 600px the mockup runs to the screen edges and the band ends with it, so
	   the mockup's own black never meets the band's. */
	@media (max-width: 599.98px) {
		.ow-hero__stage {
			margin-inline: calc(var(--page-gutter) * -1);
			padding-block-end: 0;
		}

		.ow-hero__stage::before {
			content: none;
		}

		.ow-hero__stage :global(.ow-hero__mockup) {
			border-radius: 0;
		}

	}

	@media (min-width: 600px) {
		.ow-hero__inner {
			padding-block-start: var(--space-64);
		}
	}

	@media (min-width: 1200px) {
		/* Photo: title and overview in columns 1 to 5, the photo from column 7. */
		.ow-hero--photo .ow-hero__inner {
			grid-template-areas: none;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-rows: auto 1fr auto;
			gap: var(--space-32) var(--gutter);
		}

		.ow-hero--photo .ow-hero__lead {
			grid-area: 1 / 1 / 2 / span 5;
		}

		.ow-hero--photo .ow-hero__overview {
			grid-area: 2 / 1 / 3 / span 5;
		}

		.ow-hero--photo .ow-hero__media {
			grid-area: 1 / 7 / 3 / -1;
		}

		.ow-hero--photo .ow-hero__meta {
			grid-area: 3 / 1 / 4 / -1;
		}

		/* The photo runs to the right edge of the viewport and fades in from the copy side. */
		.ow-hero--photo .ow-hero__media {
			align-self: center;
			margin-inline: 0 calc((100vw - min(100vw, var(--content-wide) + 2 * var(--page-gutter))) / -2 - var(--page-gutter));
			mask-image: linear-gradient(to right, transparent, #000 20%), linear-gradient(to bottom, transparent, #000 15%, #000 85%, transparent);
			mask-composite: intersect;
		}

		/* Stage: title and overview across the top, the facts under them, then the mockup over the band. */
		.ow-hero--stage .ow-hero__inner {
			grid-template-areas: 'lead' 'overview' 'meta' 'media';
			padding-block-end: 0;
		}

		/* Overview in columns 1 to 7, the live site link from column 9, level with its last line. */
		.ow-hero--stage .ow-hero__overview {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gutter);
		}

		.ow-hero--stage .ow-hero__overview > :global(:not(.ow-hero__live)) {
			grid-column: 1 / span 7;
		}

		.ow-hero--stage .ow-hero__live {
			grid-column: 9 / -1;
			grid-row: 1 / span 3;
			align-self: end;
		}

		.ow-hero__stage {
			padding-block: var(--space-16) var(--space-64);
		}

		.ow-hero__stage :global(.ow-hero__mockup) {
			inline-size: min(100%, 62.5rem);
		}
	}
</style>
