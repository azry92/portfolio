---
// A label-only link on home under the case study cards: Other Works and Fun, as a text
// link with an arrow (.link-arrow in global.css). WorkGrid sets the hairline rows.
interface Props {
	label: string;
	href: string;
}

const { label, href } = Astro.props;
---

<a class="link-arrow short-card" href={href}>{label} <span class="link-arrow__arrow" aria-hidden="true">→</span></a>
