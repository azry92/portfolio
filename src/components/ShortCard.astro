---
// A label-only link card, shorter than a case study card: Other Works and Fun on home.
interface Props {
	label: string;
	href: string;
}

const { label, href } = Astro.props;
---

<a class="short-card" href={href}>{label}</a>

<style>
	.short-card {
		display: grid;
		place-items: center;
		/* About 40% of a case study card's height. */
		block-size: var(--space-64);
		background-color: var(--color-pattern-grey);
		color: var(--color-text);
		font-size: var(--text-14);
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
	}

	@media (min-width: 768px) {
		.short-card {
			block-size: calc(var(--space-64) + var(--space-12));
		}
	}

	/* Touch screens keep a tapped card in its hover state, so the fill follows focus only. */
	.short-card:focus-visible {
		background-color: var(--color-accent);
		color: var(--color-text-inverse);
	}

	@media (hover: hover) {
		.short-card:hover {
			background-color: var(--color-accent);
			color: var(--color-text-inverse);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.short-card {
			transition:
				background-color 150ms ease-out,
				color 150ms ease-out;
		}
	}
</style>
