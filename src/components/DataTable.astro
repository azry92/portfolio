---
// A Markdown table. The first column labels each row. Below 720px each row
// stacks into a block: the middle columns as short "Name: value" lines, the last
// column (the answer) set off by a rule instead of its name. The ARIA roles keep
// it a table for screen readers once the CSS display changes, so every cell
// still reads with its column header.
interface Props {
	head: string[];
	/** Cell HTML, one array per row. */
	rows: string[][];
}

const { head, rows } = Astro.props;
// Column names as plain text for the stacked labels.
const labels = head.map((cell) => cell.replace(/<[^>]+>/g, ''));
---

<table class="data-table" role="table">
	<thead role="rowgroup">
		<tr role="row">{head.map((cell) => <th scope="col" role="columnheader" set:html={cell} />)}</tr>
	</thead>
	<tbody role="rowgroup">
		{
			rows.map(([first, ...rest]) => (
				<tr role="row">
					<th scope="row" role="rowheader" set:html={first} />
					{rest.map((cell, i) => (
						<td role="cell" data-label={labels[i + 1]} set:html={cell} />
					))}
				</tr>
			))
		}
	</tbody>
</table>

<style>
	.data-table {
		inline-size: 100%;
		border-collapse: collapse;
		font-size: var(--text-16);
		line-height: 1.4;
		text-align: start;
	}

	th,
	td {
		padding: var(--space-16);
		border-block-end: var(--border-width) solid var(--color-border);
		text-align: start;
		vertical-align: top;
	}

	/* A plain header over a 2px rule; the body rows keep the hairlines. */
	/* Flush left: the first column starts on the text edge. */
	th:first-child,
	td:first-child {
		padding-inline-start: 0;
	}

	thead th {
		padding-block-start: 0;
		border-block-end: 2px solid var(--color-text);
		color: var(--color-text-muted);
		font-size: var(--text-14);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	tbody th {
		font-weight: var(--weight-semibold);
	}

	@media (min-width: 720px) {
		tbody th {
			inline-size: 34%;
		}
	}

	@media (max-width: 719.98px) {
		.data-table,
		tbody,
		tr,
		th,
		td {
			display: block;
		}

		thead {
			position: absolute;
			inline-size: 1px;
			block-size: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}

		tbody tr {
			display: grid;
			gap: var(--space-8);
			padding-block: var(--space-16);
			border-block-end: var(--border-width) solid var(--color-border);
		}

		th,
		td {
			padding-block: 0;
			border: 0;
		}

		td:not(:last-child) {
			color: var(--color-text-muted);
			font-size: var(--text-14);
		}

		td:not(:last-child)::before {
			content: attr(data-label) ': ';
		}

		td:last-child {
			margin-block-start: var(--space-4);
			padding-inline-start: var(--space-12);
			border-inline-start: 2px solid var(--accent, var(--color-surface-inverse));
		}
	}
</style>
