---
// A short, muted, looping motion piece, shown at no more than its own width and
// aligned to the start of the column like every other figure.
// It starts only when the viewer allows motion; otherwise the poster stays.
// The Pause/Play button appears once the script runs.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: string;
	/** A still from the video at the video's own size; it sets the displayed width and height. */
	poster: ImageMetadata;
	alt: string;
}

const { src, poster, alt } = Astro.props;
const still = await getImage({ src: poster, width: poster.width, format: 'webp' });
---

<div class="motion-video" data-motion-video style={`--video-width: ${poster.width}px`}>
	<video src={src} poster={still.src} width={poster.width} height={poster.height} aria-label={alt} muted loop playsinline preload="none"></video>
	<button class="motion-video__toggle" type="button" data-motion-video-toggle hidden>Play</button>
</div>

<script>
	import '../scripts/motion-video';
</script>

<style>
	.motion-video {
		position: relative;
		inline-size: 100%;
		max-inline-size: var(--video-width);
	}

	video {
		inline-size: 100%;
		block-size: auto;
		border-radius: var(--radius-sm);
	}

	.motion-video__toggle {
		position: absolute;
		inset-block-end: var(--space-12);
		inset-inline-end: var(--space-12);
		min-inline-size: 4.5rem;
		min-block-size: 2.75rem;
		padding: var(--space-8) var(--space-16);
		border: var(--border-width) solid var(--color-border);
		border-radius: 999px;
		background-color: var(--color-surface);
		color: var(--color-text);
		font-size: var(--text-14);
		font-weight: var(--weight-semibold);
		cursor: pointer;
	}

	.motion-video__toggle:hover {
		background-color: var(--color-bg);
	}
</style>
