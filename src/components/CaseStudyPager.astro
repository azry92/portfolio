---
// Previous and next case study, by `order`, wrapping at both ends. Next is the lead: a
// hairline-topped row with the label in columns 1 to 4 and the project name from column 5.
import type { CollectionEntry } from 'astro:content';

interface Props {
	prev: CollectionEntry<'caseStudies'>;
	next: CollectionEntry<'caseStudies'>;
}

const { prev, next } = Astro.props;
---

<nav class="pager container" aria-label="Case studies">
	<ul class="pager__inner" role="list">
		<li>
			<a class="pager__next" href={`/work/${next.id}`} rel="next">
				<span class="pager__label section-label">Next read</span>
				<span class="pager__name">
					{next.data.title}
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
				</span>
			</a>
		</li>
		<li class="pager__prev">
			<a href={`/work/${prev.id}`} rel="prev">
				<span class="pager__small">Previous:</span>
				{prev.data.title}
			</a>
		</li>
	</ul>
</nav>

<style>
	.pager__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-8);
		padding: var(--space-32) 0 var(--space-48);
		border-block-start: var(--rule);
		list-style: none;
	}

	.pager a {
		color: var(--color-text);
		text-decoration: none;
	}

	.pager__next {
		display: grid;
		gap: var(--space-12);
	}

	.pager__name {
		display: flex;
		gap: var(--space-16);
		align-items: center;
		font-family: var(--font-display);
		/* 24px on a phone keeps PLANETSTEWARDS and its arrow on one line at 360px. */
		font-size: var(--text-24);
		font-weight: var(--weight-bold);
		line-height: var(--leading-heading);
	}

	.pager__name svg {
		flex: none;
		inline-size: 0.75em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.pager__next:hover .pager__name,
	.pager__next:focus-visible .pager__name {
		color: var(--color-accent);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.15em;
	}

	.pager__prev a {
		display: inline-block;
		padding-block: var(--space-8);
		color: var(--color-text-muted);
	}

	.pager__prev a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.pager__small {
		margin-inline-end: var(--space-4);
	}

	@media (min-width: 600px) {
		.pager__name {
			font-size: var(--text-section);
		}
	}

	/* From 900px the label holds columns 1 to 4 and the name and Previous start at 5. */
	@media (min-width: 900px) {
		.pager__inner {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gutter);
			padding-block: var(--space-48) var(--space-64);
		}

		.pager__inner > li,
		.pager__next {
			display: grid;
			grid-column: 1 / -1;
			grid-template-columns: subgrid;
		}

		.pager__next {
			align-items: baseline;
		}

		.pager__label {
			grid-column: 1 / span 4;
		}

		.pager__name,
		.pager__prev a {
			grid-column: 5 / -1;
			justify-self: start;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.pager__name svg {
			transition: transform 150ms ease-out;
		}

		.pager__next:hover svg {
			transform: translateX(var(--space-4));
		}
	}
</style>
