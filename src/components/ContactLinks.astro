---
import { contact, cvLabel, site } from '../data/site';

interface ContactLink {
	label: string;
	href: string;
	icon: 'email' | 'linkedin' | 'cv';
	/** Opens in a new tab with rel="noopener" (the CV PDF). */
	newTab?: boolean;
}

const links: ContactLink[] = [
	{ label: 'Email', href: `mailto:${contact.email}`, icon: 'email' },
	{ label: 'LinkedIn', href: contact.linkedin, icon: 'linkedin' },
	{ label: cvLabel, href: site.cv, icon: 'cv', newTab: true },
];
---

<div class="contact">
	<p class="contact__heading">{contact.heading}</p>
	<ul class="contact__links" role="list">
		{
			links.map((link) => (
				<li>
					<a
						class="contact__link"
						href={link.href}
						target={link.newTab ? '_blank' : undefined}
						rel={link.newTab ? 'noopener' : undefined}
						aria-label={link.newTab ? link.label : undefined}
					>
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							{link.icon === 'email' && (
								<>
									<rect x="3" y="5" width="18" height="14" rx="2" />
									<path d="m3 7 9 6 9-6" />
								</>
							)}
							{link.icon === 'linkedin' && (
								<>
									<rect x="3" y="3" width="18" height="18" rx="2" />
									<path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" />
								</>
							)}
							{link.icon === 'cv' && (
								<>
									<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z" />
									<path d="M14 3v5h5M12 11v6M9 14l3 3 3-3" />
								</>
							)}
						</svg>
						<span class="visually-hidden">{link.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>

<style>
	.contact {
		--contact-size: 44px;
	}

	@media (min-width: 1200px) {
		.contact {
			--contact-size: 60px;
		}
	}

	.contact__heading {
		font-size: var(--text-16);
	}

	@media (min-width: 768px) {
		.contact__heading {
			font-size: var(--text-18);
		}
	}

	.contact__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: var(--contact-justify, flex-start);
		gap: var(--space-24);
		margin-block-start: var(--space-16);
		padding: 0;
		list-style: none;
	}

	.contact__link {
		display: grid;
		place-items: center;
		inline-size: var(--contact-size);
		block-size: var(--contact-size);
		border-radius: var(--radius-pill);
		background-color: var(--color-pattern-grey);
		color: var(--color-text);
	}

	.contact__link:hover,
	.contact__link:focus-visible {
		background-color: var(--color-accent);
		color: var(--color-text-inverse);
	}

	@media (prefers-reduced-motion: no-preference) {
		.contact__link {
			transition:
				background-color 150ms ease-out,
				color 150ms ease-out;
		}
	}

	.contact__link svg {
		inline-size: 45%;
		block-size: 45%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
