---
import { contact, cvLabel, site } from '../data/site';

interface ContactLink {
	/** The visible label. */
	label: string;
	/** The accessible name when the link opens a new tab; it starts with the visible label. */
	ariaLabel?: string;
	href: string;
	icon: 'email' | 'linkedin' | 'cv' | 'github';
	/** Opens in a new tab with rel="noopener" (the CV PDF, this site's repository). */
	newTab?: boolean;
}

const links: ContactLink[] = [
	{ label: 'Email', href: `mailto:${contact.email}`, icon: 'email' },
	{ label: 'LinkedIn', href: contact.linkedin, icon: 'linkedin' },
	{ label: 'CV', ariaLabel: cvLabel, href: site.cv, icon: 'cv', newTab: true },
	{
		label: 'Source code',
		ariaLabel: 'Source code for this site, on GitHub, opens in a new tab',
		href: contact.github,
		icon: 'github',
		newTab: true,
	},
];
---

<div class="contact">
	<p class="contact__heading">{contact.heading}</p>
	{/* The address in full, so it can be copied without a mail app; one click selects it. */}
	<p class="contact__address">{contact.email}</p>
	<ul class="contact__links" role="list">
		{
			links.map((link) => (
				<li>
					<a
						class="contact__link"
						href={link.href}
						target={link.newTab ? '_blank' : undefined}
						rel={link.newTab ? 'noopener' : undefined}
						aria-label={link.ariaLabel}
					>
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							{link.icon === 'email' && (
								<>
									<rect x="3" y="5" width="18" height="14" rx="2" />
									<path d="m3 7 9 6 9-6" />
								</>
							)}
							{link.icon === 'linkedin' && (
								<>
									<rect x="3" y="3" width="18" height="18" rx="2" />
									<path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" />
								</>
							)}
							{link.icon === 'cv' && (
								<>
									<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z" />
									<path d="M14 3v5h5M12 11v6M9 14l3 3 3-3" />
								</>
							)}
							{/* The GitHub mark as a line icon, from Feather Icons (MIT). */}
							{link.icon === 'github' && (
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
							)}
						</svg>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</div>

<style>
	.contact__heading {
		font-size: var(--text-16);
	}

	@media (min-width: 768px) {
		.contact__heading {
			font-size: var(--text-18);
		}
	}

	.contact__address {
		margin-block-start: var(--space-8);
		font-family: var(--font-display);
		font-size: var(--text-18);
		font-weight: var(--weight-semibold);
		overflow-wrap: anywhere;
		user-select: all;
	}

	@media (min-width: 768px) {
		.contact__address {
			font-size: var(--text-24);
		}
	}

	.contact__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: var(--space-12);
		margin-block-start: var(--space-16);
		padding: 0;
		list-style: none;
	}

	/* Outline buttons with an icon and a label, 48px tall. */
	.contact__link {
		display: inline-flex;
		gap: var(--space-8);
		align-items: center;
		min-block-size: var(--space-48);
		padding-inline: var(--space-16);
		border: var(--border-width) solid currentColor;
		color: var(--color-text);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-heading);
		text-decoration: none;
	}

	.contact__link:hover,
	.contact__link:focus-visible {
		border-color: var(--color-accent);
		background-color: var(--color-accent);
		color: var(--color-text-inverse);
	}

	@media (prefers-reduced-motion: no-preference) {
		.contact__link {
			transition:
				border-color 150ms ease-out,
				background-color 150ms ease-out,
				color 150ms ease-out;
		}
	}

	.contact__link svg {
		flex: none;
		inline-size: 1.25em;
		block-size: 1.25em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
