---
// "Rows of phones, one labelled row per stage": each subsection becomes a row of
// phones under a hairline, labelled by its heading and described by its caption. A stage
// with the "scrolling steps" note draws its row as ScrollSteps instead, its label above.
import ChapterHeader from './ChapterHeader.astro';
import FigureGrid from './FigureGrid.astro';
import Prose from './Prose.astro';
import ScrollSteps from './ScrollSteps.astro';
import type { Section } from '../lib/case-study/parse';

interface Props {
	section: Section;
	/** The section's place on the page, for its numbered label. */
	number: number;
}

const { section, number } = Astro.props;

const stages = section.subsections.map((stage) => {
	const figures = stage.blocks.filter((block) => block.kind === 'figures');
	if (figures.length !== 1 || stage.blocks.length !== 1) {
		throw new Error(`Stage "${stage.heading}" must hold exactly one row of images and nothing else`);
	}
	return { ...stage, row: figures[0], scroll: stage.layout?.kind === 'scroll-steps' };
});
// Every stage shares the longest row's column count, so phones are the same size in every row
// (shorter rows leave columns empty on the right). Below 600px all phone rows go 2 per row.
// A scrolling stage still counts, so the rows keep the size they had beside a row of five.
const columns = Math.max(...stages.map((stage) => stage.row.items.length));
---

<section class="stages" aria-labelledby={section.id}>
	<div class="stages__inner container container-rule">
		<ChapterHeader number={number} id={section.id} heading={section.heading} subhead={section.subhead} />
		{section.blocks.length > 0 && <Prose html={section.blocks.map((b) => (b.kind === 'prose' ? b.html : '')).join('')} />}
		<ol class="stages__list" role="list">
			{
				stages.map((stage) => (
					<li class:list={['stage', { 'stage--scroll': stage.scroll }]}>
						<div class="stage__label">
							<h3 id={stage.id}>{stage.heading}</h3>
							{stage.row.caption && <p set:html={stage.row.caption} />}
						</div>
						{stage.scroll ? (
							<ScrollSteps run={stage.row} />
						) : (
							<FigureGrid items={stage.row.items} frame="phone" columns={columns} />
						)}
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	/* Tighter on phones, like the other case study sections. */
	.stages__inner {
		display: grid;
		gap: var(--space-32);
		padding-block: var(--space-48);
	}

	/* minmax(0, 1fr) keeps a snap row inside the page instead of widening its column. */
	.stages__list {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-48);
		padding: 0;
		list-style: none;
	}

	/* A hairline between stages, none above the first (the section's own rule). */
	.stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-24);
	}

	.stage + .stage {
		padding-block-start: var(--space-48);
		border-block-start: var(--rule);
	}

	.stage__label {
		display: grid;
		gap: var(--space-8);
		align-content: start;
	}

	.stage__label h3 {
		font-size: var(--text-24);
	}

	@media (min-width: 600px) {
		.stages__inner {
			gap: var(--space-48);
			padding-block: var(--space-64);
		}

		.stages__list {
			gap: var(--space-64);
		}

		.stage + .stage {
			padding-block-start: var(--space-64);
		}
	}

	@media (min-width: 1200px) {
		.stage__label h3 {
			font-size: var(--text-32);
		}

		/* Phones in columns 1 to 8, the label in 10 to 12. */
		.stage:not(.stage--scroll) {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--gutter);
			align-items: start;
		}

		.stage:not(.stage--scroll) > :global(*) {
			grid-column: 1 / span 8;
		}

		/* The label sits to the right of its row, as in the stage reference. */
		.stage:not(.stage--scroll) > .stage__label {
			grid-column: 10 / -1;
			grid-row: 1;
		}
	}
</style>
