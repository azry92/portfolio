---
// One Lab entry: the clip in a labelled browser frame, the name, the build time as a
// number and unit, one line of copy, the tools as text pills and a link out.
// What the clip shows is the video's accessible name, so the card has no caption.
import type { CollectionEntry } from 'astro:content';
import MotionVideo from './MotionVideo.astro';

interface Props {
	entry: CollectionEntry<'lab'>;
}

const { title, line, duration, tools, video, frame_label, video_size, video_label, poster, link } = Astro.props.entry.data;
const unit = duration.amount === 1 ? duration.unit : `${duration.unit}s`;
const external = !link.href.startsWith('/');
---

<article class="lab-card">
	<MotionVideo
		src={`/videos/${video}`}
		poster={poster}
		size={video_size}
		alt={video_label}
		frame="browser"
		frameLabel={frame_label}
		sizes="(min-width: 1800px) 750px, (min-width: 600px) 50vw, 100vw"
	/>
	<h3 class="lab-card__title">{title}</h3>
	<p class="lab-card__time">
		<span class="visually-hidden">Build time: </span><span class="lab-card__amount">{duration.amount}</span>{' '}
		<span class="lab-card__unit">{unit}</span>
	</p>
	<p class="lab-card__line">{line}</p>
	<ul class="lab-card__tools" role="list" aria-label="Tools">
		{tools.map((tool) => <li>{tool}</li>)}
	</ul>
	<a
		class="link-arrow"
		href={link.href}
		target={external ? '_blank' : undefined}
		rel={external ? 'noopener' : undefined}
		aria-label={external ? `${link.label}, opens in a new tab` : undefined}
		>{link.label} <span class="link-arrow__arrow" aria-hidden="true">→</span></a
	>
</article>

<style>
	.lab-card {
		display: grid;
		gap: var(--space-12);
		align-content: start;
	}

	.lab-card :global(.motion-video) {
		max-inline-size: none;
		margin-block-end: var(--space-12);
	}

	.lab-card__title {
		font-size: var(--text-24);
		font-weight: var(--weight-semibold);
	}

	.lab-card__time {
		display: flex;
		gap: var(--space-8);
		align-items: baseline;
	}

	.lab-card__amount {
		font-family: var(--font-display);
		font-size: var(--text-32);
		font-weight: var(--weight-bold);
		line-height: 1;
	}

	.lab-card__unit {
		font-size: var(--text-14);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.lab-card__line {
		max-inline-size: var(--measure);
	}

	/* Text pills, not controls: a 1px outline in the text colour. */
	.lab-card__tools {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-8);
		padding: 0;
		list-style: none;
	}

	.lab-card__tools li {
		padding: var(--space-4) var(--space-12);
		border: var(--border-width) solid currentColor;
		border-radius: var(--radius-pill);
		font-size: var(--text-14);
		line-height: var(--leading-heading);
	}

	.lab-card .link-arrow {
		justify-self: start;
	}
</style>
