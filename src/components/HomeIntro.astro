---
// Home intro: logo, greeting, the page h1 and the short about.
import Logo from './Logo.astro';
import { intro } from '../data/site';

// Keep "e-commerce" whole: browsers otherwise break inside.
const aboutParts = intro.about.split(/(e-commerce)/);
---

<section class="home-intro" aria-labelledby="home-title">
	<div class="home-intro__logo">
		<Logo size="var(--intro-logo-size)" decorative />
	</div>
	<hgroup class="home-intro__heading">
		<p class="home-intro__greeting">{intro.greeting}</p>
		<h1 id="home-title" class="home-intro__title">{intro.title}</h1>
	</hgroup>
	<p class="home-intro__about">
		{aboutParts.map((part) => (part === 'e-commerce' ? <span class="home-intro__nowrap">{part}</span> : part))}
	</p>
</section>

<style>
	/* Mobile: logo, greeting and title centred as in home-01-hero-mobile; the about stays left. */
	.home-intro {
		--intro-logo-size: 60px;

		padding-block-start: var(--space-32);
	}

	.home-intro__logo {
		display: flex;
		justify-content: center;
	}

	.home-intro__heading {
		margin-block-start: var(--space-24);
		text-align: center;
	}

	.home-intro__greeting {
		font-family: var(--font-display);
		font-size: var(--text-24);
		font-weight: var(--weight-light);
		line-height: var(--leading-heading);
	}

	/* Light, like the greeting, so the title stays on one line beside "See the Work". */
	.home-intro__title {
		margin-block-start: var(--space-4);
		font-size: var(--text-display);
		font-weight: var(--weight-light);
	}

	.home-intro__about {
		margin-block-start: var(--space-24);
	}

	.home-intro__nowrap {
		white-space: nowrap;
	}

	@media (min-width: 768px) {
		.home-intro {
			--intro-logo-size: 80px;

			padding-block-start: var(--space-48);
		}

		.home-intro__logo {
			justify-content: flex-start;
		}

		.home-intro__heading {
			text-align: start;
		}

		/* Desktop: greeting and title share one size, as in home-01-hero-desktop */
		.home-intro__greeting {
			font-size: var(--text-display);
		}

		.home-intro__about {
			max-inline-size: 36ch;
			margin-block-start: var(--space-32);
			font-size: var(--text-18);
		}
	}

	/* Two-column layout: rows 1 to 3 of the home grid (logo, heading, body), so the
	   heading row can share its baseline with "See the Work". At 40px the title stays
	   on one line and runs past this column, leaving room for that heading. */
	@media (min-width: 1200px) {
		.home-intro {
			display: grid;
			grid-template-rows: subgrid;
			grid-column: 1;
			grid-row: 1 / span 3;
		}

		.home-intro__heading {
			inline-size: max-content;
			align-self: last baseline;
		}

		.home-intro__greeting,
		.home-intro__title {
			font-size: var(--text-40);
		}
	}
</style>
