---
// Full-bleed IA pattern band on home, between the red Lab section and About. Decorative.
// It opens flush with Lab as a cream outline on the same red (state 03), and as it scrolls
// through the viewport the red drains away from the bottom, leaving the glyphs solid red
// on grey (state 01), the rest state that hands over to the cream About.
// CSS only: a scroll-driven animation. Under reduced motion, or where scroll timelines
// aren't supported, the band rests on solid red on grey, still flush under the red.
import { glyph, tileRows, viewBox } from '../lib/glyphPattern';

const vb = `0 0 ${viewBox.width} ${viewBox.height}`;
---

<div class="glyph-band" aria-hidden="true" style={`--band-aspect: ${viewBox.width} / ${viewBox.height}`}>
	<svg class="glyph-band__layer glyph-band__rest" viewBox={vb} focusable="false">
		<defs>
			<g id="glyph-ia">
				<path d={glyph.I} vector-effect="non-scaling-stroke"></path>
				<path d={glyph.A} vector-effect="non-scaling-stroke"></path>
			</g>
			<g id="glyph-art">
				{tileRows.flat().map((copies) => copies.map((t) => <use href="#glyph-ia" transform={t} />))}
			</g>
		</defs>
		{
			tileRows.flat().map((copies) => (
				<g class="glyph-band__tile">
					{copies.map((t) => (
						<use href="#glyph-ia" transform={t} />
					))}
				</g>
			))
		}
	</svg>

	<svg class="glyph-band__layer glyph-band__field" viewBox={vb} focusable="false">
		<rect class="glyph-band__red" width={viewBox.width} height={viewBox.height}></rect>
		<!-- Stroke every copy, then fill over it: only the outer edge of the union stays visible. -->
		<use class="glyph-band__outline" href="#glyph-art"></use>
		<use class="glyph-band__red" href="#glyph-art"></use>
	</svg>
</div>

<style>
	.glyph-band {
		/* Both rows show whole at every width. The band is never shorter than the art's
		   height at full screen width, so the art always spans the screen edge to edge. */
		--band-h: max(165px, calc(100vw / (var(--band-aspect))));

		position: relative;
		block-size: var(--band-h);
		overflow: hidden;
		background-color: var(--color-pattern-grey);
	}

	@media (min-width: 768px) {
		.glyph-band {
			--band-h: max(clamp(220px, 33svh, 400px), calc(100vw / (var(--band-aspect))));
		}
	}

	.glyph-band__layer {
		position: absolute;
		inset-block-end: 0;
		inset-inline-start: 50%;
		block-size: var(--band-h);
		inline-size: auto;
		max-inline-size: none;
		aspect-ratio: var(--band-aspect);
		translate: -50% 0;
		pointer-events: none;
	}

	/* 01, the rest state: solid red on grey, and the hover flip */
	.glyph-band__rest {
		fill: var(--color-accent);
		stroke: var(--color-accent);
		stroke-width: 0;
	}

	@media (hover: hover) {
		.glyph-band__tile {
			pointer-events: all;
		}

		.glyph-band__tile:hover {
			fill: none;
			stroke-width: 1.5px;
		}
	}

	/* 03, the opening state: a cream hairline outline on the same red as Lab. */
	.glyph-band__field {
		display: none;
	}

	.glyph-band__red {
		fill: var(--color-accent);
	}

	.glyph-band__outline {
		fill: none;
		stroke: var(--color-pattern-cream);
		stroke-width: 2px;
	}

	/* The scrub: 0 when the band sits whole in the viewport, 1 when its top reaches the
	   sticky header. The red field (and its outlines) clips away from the bottom, so the red
	   stays joined to Lab until it has gone. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.glyph-band {
				view-timeline: --glyph-band block;
				view-timeline-inset: var(--header-h) 0;
				--band-timeline: --glyph-band;
			}

			.glyph-band__field {
				display: block;
				animation-name: glyph-band-drain;
				animation-timing-function: linear;
				animation-fill-mode: both;
				/* Through a variable: the minifier would otherwise fold the timeline into the
				   animation shorthand, which browsers reject. */
				animation-timeline: var(--band-timeline);
				animation-range: entry 100% exit 0%;
			}

			/* The top row's outlines meet the band's top edge and would draw a cream line
			   along the join with Lab: a 2px strip of red covers it while the red shows. */
			.glyph-band::before {
				content: '';
				position: absolute;
				z-index: 1;
				inset: 0 0 auto;
				block-size: 2px;
				background-color: var(--color-accent);
				animation-name: glyph-band-edge;
				animation-timing-function: linear;
				animation-fill-mode: both;
				/* Through a variable: the minifier would otherwise fold the timeline into the
				   animation shorthand, which browsers reject. */
				animation-timeline: var(--band-timeline);
				animation-range: entry 100% exit 0%;
			}
		}
	}

	@keyframes glyph-band-drain {
		from {
			clip-path: inset(0 0 0 0);
		}
		to {
			clip-path: inset(0 0 100% 0);
		}
	}

	@keyframes glyph-band-edge {
		0%,
		99% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
</style>
