---
import ContactLinks from './ContactLinks.astro';
import { footerLine, nav } from '../data/site';

interface Props {
	/** Off on home, where the sticky header nav sits a short scroll away. */
	showNav?: boolean;
}

const { showNav = true } = Astro.props;
---

<footer id="contact" class="site-footer container">
	<div class="site-footer__inner grid-12">
		<ContactLinks />
		<div class="site-footer__meta">
			{
				showNav && (
					<nav aria-label="Footer">
						<ul class="site-footer__nav" role="list">
							{nav.map((item) => (
								<li>
									<a
										href={item.href}
										target={item.newTab ? '_blank' : undefined}
										rel={item.newTab ? 'noopener' : undefined}
										aria-label={item.ariaLabel}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
			<p class="site-footer__line">{footerLine}</p>
		</div>
	</div>
</footer>

<style>
	/* A hairline, then two groups 32px apart: the contact line with its squares (16px
	   apart, set in ContactLinks), then the nav with the credit line. From 900px they sit
	   side by side on the grid, the second from column 7, bottoms aligned. */
	.site-footer__inner {
		row-gap: var(--space-32);
		padding-block: var(--space-48) var(--space-32);
		border-block-start: var(--rule);
	}

	@media (min-width: 900px) {
		.site-footer__inner {
			align-items: end;
		}

		.site-footer__inner > :first-child {
			grid-column: 1 / span 6;
		}

		.site-footer__meta {
			grid-column: 7 / -1;
		}
	}

	/* The links' 8px block padding keeps their tap targets tall, so a 4px gap leaves
	   12px between the link text and the credit line. */
	.site-footer__meta {
		display: grid;
		gap: var(--space-4);
	}

	.site-footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-8) var(--space-24);
		padding: 0;
		list-style: none;
		font-size: var(--text-14);
	}

	.site-footer__nav a {
		display: inline-block;
		padding-block: var(--space-8);
		color: var(--color-text);
		text-decoration: none;
	}

	.site-footer__nav a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-footer__nav a {
			transition: color 150ms ease-out;
		}
	}

	.site-footer__line {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}
</style>
