---
import ContactLinks from './ContactLinks.astro';
import { footerLine, nav } from '../data/site';

interface Props {
	/**
	 * site: full-width footer with text nav, on every page but home.
	 * home: no nav or container; the home grid places it (left column from 1200px).
	 */
	variant?: 'site' | 'home';
}

const { variant = 'site' } = Astro.props;
---

<footer class:list={['site-footer', `site-footer--${variant}`]}>
	<div class:list={['site-footer__inner', { container: variant === 'site' }]}>
		<ContactLinks />
		<div class="site-footer__meta">
			{
				variant === 'site' && (
					<nav aria-label="Footer">
						<ul class="site-footer__nav" role="list">
							{nav.map((item) => (
								<li>
									<a href={item.href} download={item.download || undefined}>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
			<p class="site-footer__line">{footerLine}</p>
		</div>
	</div>
</footer>

<style>
	/* Two groups, 32px apart: the contact line with its circles (16px apart, set in
	   ContactLinks), then the nav with the credit line. */
	.site-footer__inner {
		display: grid;
		gap: var(--space-32);
		padding-block: var(--space-48) var(--space-32);
	}

	/* The links' 8px block padding keeps their tap targets tall, so a 4px gap leaves
	   12px between the link text and the credit line. */
	.site-footer__meta {
		display: grid;
		gap: var(--space-4);
	}

	.site-footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-8) var(--space-24);
		padding: 0;
		list-style: none;
		font-size: var(--text-14);
	}

	.site-footer__nav a {
		display: inline-block;
		padding-block: var(--space-8);
		color: var(--color-text);
		text-decoration: none;
	}

	.site-footer__nav a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: no-preference) {
		.site-footer__nav a {
			transition: color 150ms ease-out;
		}
	}

	.site-footer__line {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	/* Home: centred at the end of the page until the two-column layout takes over */
	.site-footer--home {
		--contact-justify: center;

		text-align: center;
	}

	@media (min-width: 1200px) {
		.site-footer--home {
			--contact-justify: flex-start;

			text-align: start;
		}

		/* The home grid adds the space below, so the last line sits on the grid's bottom edge. */
		.site-footer--home .site-footer__inner {
			padding-block: var(--space-24) 0;
		}
	}
</style>
