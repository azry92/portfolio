---
// Minimal browser window: a thin bar with three dots, no URL text.
// Pass a screenshot (`src` + `alt`) or slot in a <video>.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src?: ImageMetadata;
	alt?: string;
	/** Crop tall screenshots to this ratio, e.g. "16 / 10". Defaults to the image's own ratio. */
	aspect?: string;
	widths?: number[];
	sizes?: string;
	loading?: 'lazy' | 'eager';
	class?: string;
}

const {
	src,
	alt = '',
	aspect,
	widths = [640, 960, 1280, 1920],
	sizes = '(min-width: 1200px) 1200px, 100vw',
	loading = 'lazy',
	class: className,
} = Astro.props;

const hasSlot = Astro.slots.has('default');
---

<div class:list={['browser', className]} style={aspect ? `--browser-aspect: ${aspect}` : undefined}>
	<div class="browser__bar" aria-hidden="true">
		<span></span>
		<span></span>
		<span></span>
	</div>
	<div class:list={['browser__content', { 'browser__content--cropped': aspect }]}>
		{
			hasSlot ? (
				<slot />
			) : (
				src && (
					<Picture
						src={src}
						alt={alt}
						formats={['avif', 'webp']}
						widths={widths.filter((w) => w <= src.width)}
						sizes={sizes}
						loading={loading}
					/>
				)
			)
		}
	</div>
</div>

<style>
	.browser {
		overflow: hidden;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-sm);
		background-color: var(--color-surface);
	}

	.browser__bar {
		display: flex;
		gap: 6px;
		align-items: center;
		block-size: 1.75rem;
		padding-inline: var(--space-12);
		border-block-end: var(--border-width) solid var(--color-border);
		background-color: var(--color-bg);
	}

	.browser__bar span {
		inline-size: 8px;
		block-size: 8px;
		border-radius: 50%;
		background-color: color-mix(in srgb, var(--color-text-muted) 35%, transparent);
	}

	.browser__content :global(img),
	.browser__content :global(video) {
		inline-size: 100%;
		block-size: auto;
	}

	.browser__content--cropped {
		aspect-ratio: var(--browser-aspect);
	}

	.browser__content--cropped :global(picture),
	.browser__content--cropped :global(img),
	.browser__content--cropped :global(video) {
		block-size: 100%;
		object-fit: cover;
		object-position: top;
	}
</style>
