---
// Minimal browser window: a thin bar with three dots, no URL text. Lab alone passes a
// short `label` (site · platform) for the bar; it is decorative, like the dots.
// Pass a screenshot (`src` + `alt`) or slot in a <video>.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src?: ImageMetadata;
	alt?: string;
	/** Clip tall screenshots at the bottom to this ratio, e.g. "16 / 10". Defaults to the image's own ratio. */
	aspect?: string;
	widths?: number[];
	sizes?: string;
	loading?: 'lazy' | 'eager';
	/** Short text in the bar after the dots, e.g. "AT Auto Shoppe · Shopify". Lab only. */
	label?: string;
	/** For a frame that holds the page's largest image, e.g. a hero. */
	fetchpriority?: 'high' | 'low' | 'auto';
	class?: string;
}

const {
	src,
	alt = '',
	aspect,
	widths = [640, 960, 1280, 1920],
	sizes = '(min-width: 1800px) 1600px, 100vw',
	loading = 'lazy',
	label,
	fetchpriority,
	class: className,
} = Astro.props;

const hasSlot = Astro.slots.has('default');
---

<div class:list={['browser', className]} style={aspect ? `--browser-aspect: ${aspect}` : undefined}>
	<div class="browser__bar" aria-hidden="true">
		<span class="browser__dot"></span>
		<span class="browser__dot"></span>
		<span class="browser__dot"></span>
		{label && <span class="browser__label">{label}</span>}
	</div>
	<div class:list={['browser__content', { 'browser__content--cropped': aspect }]}>
		{
			hasSlot ? (
				<slot />
			) : (
				src && (
					<Picture
						src={src}
						alt={alt}
						formats={['avif', 'webp']}
						widths={widths.filter((w) => w <= src.width)}
						sizes={sizes}
						loading={loading}
						fetchpriority={fetchpriority}
					/>
				)
			)
		}
	</div>
</div>

<style>
	.browser {
		overflow: hidden;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-sm);
		background-color: var(--color-surface);
	}

	.browser__bar {
		display: flex;
		gap: 6px;
		align-items: center;
		block-size: 1.75rem;
		padding-inline: var(--space-12);
		border-block-end: var(--border-width) solid var(--color-border);
		background-color: var(--color-bg);
	}

	.browser__dot {
		flex: none;
		inline-size: 8px;
		block-size: 8px;
		border-radius: 50%;
		background-color: color-mix(in srgb, var(--color-text-muted) 35%, transparent);
	}

	.browser__label {
		overflow: hidden;
		min-inline-size: 0;
		margin-inline-start: var(--space-8);
		color: var(--color-text-muted);
		font-size: var(--text-12);
		line-height: 1;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.browser__content :global(img),
	.browser__content :global(video) {
		inline-size: 100%;
		block-size: auto;
	}

	/* Full width, top-aligned; a tall screenshot clips at the bottom only. */
	.browser__content--cropped {
		aspect-ratio: var(--browser-aspect);
		overflow: hidden;
	}
</style>
