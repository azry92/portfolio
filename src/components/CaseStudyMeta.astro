---
// Project facts under a project's title: client, project, role, team, timeline, platform, tools, live site.
// `grid` sets them as hairline rows, two across below 1200px and one column from 1200px
// (case study hero); `row` runs them in one line under a hairline from 1200px, two across
// below that (other works).
interface Props {
	client?: string;
	project?: string;
	role?: string;
	team: string;
	timeline: string;
	platform: string;
	tools: string[];
	liveUrl?: string;
	layout?: 'grid' | 'row';
}

const { client, project, role, team, timeline, platform, tools, liveUrl, layout = 'grid' } = Astro.props;
const host = liveUrl ? new URL(liveUrl).host.replace(/^www\./, '') : undefined;
---

<dl class:list={['meta', `meta--${layout}`]}>
	{
		client && (
			<div>
				<dt>Client</dt>
				<dd>{client}</dd>
			</div>
		)
	}
	{
		project && (
			<div>
				<dt>Project</dt>
				<dd>{project}</dd>
			</div>
		)
	}
	{
		role && (
			<div>
				<dt>Role</dt>
				<dd>{role}</dd>
			</div>
		)
	}
	<div>
		<dt>Team</dt>
		<dd>{team}</dd>
	</div>
	<div>
		<dt>Timeline</dt>
		<dd>{timeline}</dd>
	</div>
	<div>
		<dt>Platform</dt>
		<dd>{platform}</dd>
	</div>
	<div>
		<dt>Tools</dt>
		<dd>
			<ul class="meta__tools" role="list">
				{tools.map((tool) => <li>{tool}</li>)}
			</ul>
		</dd>
	</div>
	{
		liveUrl && (
			<div>
				<dt>Live site</dt>
				<dd>
					<a href={liveUrl}>{host}</a>
				</dd>
			</div>
		)
	}
</dl>

<style>
	.meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-24) var(--space-32);
	}

	dt {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	.meta--grid {
		column-gap: var(--gutter);
		row-gap: 0;
	}

	.meta--grid > div {
		padding-block: var(--space-12);
		border-block-start: var(--rule);
	}

	@media (min-width: 1200px) {
		.meta--grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	dd {
		font-weight: var(--weight-semibold);
		line-height: var(--leading-heading);
	}

	.meta__tools {
		display: flex;
		flex-wrap: wrap;
		padding: 0;
		list-style: none;
	}

	.meta__tools li:not(:last-child)::after {
		content: ',\00a0';
	}

	.meta--row {
		padding-block-start: var(--space-24);
		border-block-start: var(--border-width) solid var(--color-border);
	}

	@media (min-width: 1200px) {
		.meta--row {
			grid-template-columns: none;
			grid-auto-columns: minmax(0, auto);
			grid-auto-flow: column;
			justify-content: space-between;
		}

		.meta--row > div {
			max-inline-size: 16rem;
		}
	}
</style>
