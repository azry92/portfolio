---
// The case study in three lines under the title: problem, what I did, outcome.
// With a Results section, the outcome links down to it.
interface Props {
	problem: string;
	did: string;
	outcome: string;
	/** Id of the Results heading, when the case study has one. */
	resultsId?: string;
}

const { problem, did, outcome, resultsId } = Astro.props;
---

<dl class="glance">
	<div>
		<dt>Problem</dt>
		<dd>{problem}</dd>
	</div>
	<div>
		<dt>What I did</dt>
		<dd>{did}</dd>
	</div>
	<div>
		<dt>Outcome</dt>
		<dd>
			{outcome}
			{resultsId && <a class="glance__results" href={`#${resultsId}`}>See results</a>}
		</dd>
	</div>
</dl>

<style>
	/* Three rows, a hairline above each. From 600px the term sits in its own column. */
	.glance > div {
		display: grid;
		gap: var(--space-4);
		padding-block: var(--space-12);
		border-block-start: var(--rule);
	}

	dt {
		color: var(--color-text-muted);
		font-size: var(--text-14);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (min-width: 600px) {
		.glance > div {
			grid-template-columns: 9rem minmax(0, 1fr);
			gap: var(--gutter);
			align-items: baseline;
		}
	}

	.glance__results {
		margin-inline-start: var(--space-4);
		white-space: nowrap;
	}
</style>
