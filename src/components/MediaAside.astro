---
// Copy and subsections in one column, figures in the other (left from 768px). On
// small screens the figures follow the copy and come before the subsections, as in
// the Markdown. Figures sit side by side; a phone takes a phone's width and the other
// figures share the rest. A phone beside another frame shares its bottom edge, and
// below 600px the pair stacks. One caption covers the figures.
import CaseStudyBlocks from './CaseStudyBlocks.astro';
import Figure from './Figure.astro';
import type { Frame } from '../lib/case-study/layouts';
import type { Block, Figure as FigureData, Subsection } from '../lib/case-study/parse';

interface Props {
	blocks: Block[];
	subsections: Subsection[];
	items: FigureData[];
	caption?: string;
	frames: Frame[];
	/** The media column's share of 12. */
	span: number;
}

const { blocks, subsections, items, caption, frames, span } = Astro.props;
if (items.length !== frames.length) {
	throw new Error(`MediaAside: ${frames.length} frames for ${items.length} images`);
}

const mixed = frames.includes('phone') && frames.some((frame) => frame !== 'phone');
// A lone figure fills the column; in a row, a phone gets a phone's width.
const columns = frames
	.map((frame) => (frame === 'phone' && frames.length > 1 ? 'minmax(0, 15rem)' : 'minmax(0, 1fr)'))
	.join(' ');
const share = span / Math.max(1, frames.filter((frame) => frame !== 'phone').length);
const sizeFor = (frame: Frame) =>
	frame === 'phone'
		? '240px'
		: `(min-width: 1248px) ${Math.round((1200 * share) / 12)}px, (min-width: 768px) ${Math.round((100 * share) / 12)}vw, ${mixed ? 100 : Math.round(100 / items.length)}vw`;
const Tag = caption ? 'figure' : 'div';
---

<div class="aside" style={`--media: ${span}fr; --text: ${12 - span}fr; --columns: ${columns}`}>
	<div class="aside__text">
		<CaseStudyBlocks blocks={blocks} />
	</div>
	<Tag class="aside__media">
		<div class:list={['aside__figures', { 'aside__figures--mixed': mixed }]}>
			{items.map((figure, i) => <Figure figure={figure} frame={frames[i]} sizes={sizeFor(frames[i])} />)}
		</div>
		{caption && <figcaption class="aside__caption" set:html={caption} />}
	</Tag>
	{
		subsections.length > 0 && (
			<div class="aside__subsections">
				{subsections.map((sub) => (
					<section class="aside__subsection" aria-labelledby={sub.id}>
						<h3 id={sub.id} class="aside__subtitle">
							{sub.heading}
						</h3>
						<CaseStudyBlocks blocks={sub.blocks} />
					</section>
				))}
			</div>
		)
	}
</div>

<style>
	.aside,
	.aside__text,
	.aside__media,
	.aside__subsections {
		display: grid;
		gap: var(--space-24);
		align-content: start;
	}

	.aside__subsection {
		display: grid;
		gap: var(--space-16);
		padding-block-start: var(--space-8);
	}

	.aside__subtitle {
		font-size: var(--text-24);
	}

	.aside__figures {
		display: grid;
		grid-template-columns: var(--columns);
		gap: var(--space-16);
		align-items: start;
	}

	/* A phone keeps a phone's width, centred in its column. */
	.aside__media :global(.figure--phone) {
		justify-self: center;
		inline-size: min(100%, 15rem);
	}

	.aside__figures--mixed {
		align-items: end;
	}

	/* Below 600px a phone and another frame stack, like any row of two. */
	@media (max-width: 599.98px) {
		.aside__figures--mixed {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-32);
		}
	}

	.aside__caption {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	@media (min-width: 768px) {
		.aside {
			grid-template-columns: minmax(0, var(--media)) minmax(0, var(--text));
			grid-template-rows: auto 1fr;
			gap: var(--space-24) var(--space-48);
			align-items: start;
		}

		.aside__text {
			grid-column: 2;
			grid-row: 1;
		}

		.aside__subsections {
			grid-column: 2;
			grid-row: 2;
		}

		.aside__media {
			grid-column: 1;
			grid-row: 1 / -1;
		}

		.aside__figures {
			gap: var(--space-24);
		}
	}
</style>
