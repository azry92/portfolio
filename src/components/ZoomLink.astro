---
// Wraps a figure's picture in a link to a large copy. Without JS the link opens
// the image; with JS the lightbox intercepts it.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
}

const { image } = Astro.props;
const large =
	image.format === 'svg'
		? { src: image.src, width: image.width, height: image.height }
		: await getImage({ src: image, width: Math.min(2000, image.width), format: 'webp' }).then((result) => ({
				src: result.src,
				width: Number(result.attributes.width),
				height: Number(result.attributes.height),
			}));
---

<a class="zoom" href={large.src} data-zoom data-width={large.width} data-height={large.height}>
	<slot />
	<span class="visually-hidden">(enlarge)</span>
</a>

<style>
	.zoom {
		display: block;
		cursor: zoom-in;
	}
</style>
