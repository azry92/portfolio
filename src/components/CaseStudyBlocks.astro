---
// Renders a run of parsed blocks with the component for each kind.
import DataTable from './DataTable.astro';
import FigureGrid from './FigureGrid.astro';
import MenuTree from './MenuTree.astro';
import MotionVideo from './MotionVideo.astro';
import Prose from './Prose.astro';
import RuleList from './RuleList.astro';
import StatCards from './StatCards.astro';
import SwatchRow from './SwatchRow.astro';
import type { Frame } from '../lib/case-study/layouts';
import type { Block } from '../lib/case-study/parse';

interface Props {
	blocks: Block[];
	frame?: Frame;
	/** Passed to every figure row, e.g. 1 to stack figures in a narrow column. */
	columns?: number;
	/** Passed to every figure row: box each image at one size. */
	uniform?: boolean;
}

const { blocks, frame, columns, uniform } = Astro.props;
---

{
	blocks.map((block) =>
		block.kind === 'prose' ? (
			<Prose html={block.html} />
		) : block.kind === 'table' ? (
			<DataTable head={block.head} rows={block.rows} />
		) : block.kind === 'swatches' ? (
			<SwatchRow items={block.items} />
		) : block.kind === 'tree' ? (
			<MenuTree items={block.items} />
		) : block.kind === 'stats' ? (
			<StatCards items={block.items} />
		) : block.kind === 'rules' ? (
			<RuleList items={block.items} />
		) : block.kind === 'video' ? (
			<MotionVideo src={block.src} poster={block.poster} alt={block.alt} />
		) : (
			<FigureGrid items={block.items} caption={block.caption} frame={frame} columns={columns} uniform={uniform} />
		),
	)
}
