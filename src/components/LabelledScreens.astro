---
// One run of screens stacked at the same width, each with a short label: above it on
// small screens, beside it from 768px. One caption covers the run.
import Figure from './Figure.astro';
import type { Frame } from '../lib/case-study/layouts';
import type { Figure as FigureData } from '../lib/case-study/parse';

interface Props {
	items: FigureData[];
	labels: string[];
	frame: Frame;
	caption?: string;
}

const { items, labels, frame, caption } = Astro.props;
if (items.length !== labels.length) {
	throw new Error(`LabelledScreens: ${labels.length} labels for ${items.length} images`);
}
---

<figure class="labelled">
	<ol class="labelled__list" role="list">
		{
			items.map((figure, i) => (
				<li class="labelled__item">
					<p class="labelled__label">{labels[i]}</p>
					<Figure figure={figure} frame={frame} sizes="(min-width: 1800px) 1400px, 100vw" />
				</li>
			))
		}
	</ol>
	{caption && <figcaption class="labelled__caption" set:html={caption} />}
</figure>

<style>
	.labelled {
		display: grid;
		gap: var(--space-24);
	}

	.labelled__list {
		display: grid;
		gap: var(--space-32);
		padding: 0;
	}

	.labelled__item {
		display: grid;
		gap: var(--space-12);
	}

	.labelled__label {
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
	}

	.labelled__caption {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	/* Labels take a narrow column; the caption lines up under the screens. */
	@media (min-width: 768px) {
		.labelled__item {
			grid-template-columns: 8rem minmax(0, 1fr);
			column-gap: var(--space-32);
		}

		.labelled__label {
			padding-block-start: var(--space-8);
		}

		.labelled__caption {
			max-inline-size: calc(var(--measure) + 8rem + var(--space-32));
			padding-inline-start: calc(8rem + var(--space-32));
		}
	}
</style>
