---
// "Three phones in a row with numbered step labels and arrows": one run of figures
// as an ordered list, each caption its step label. From 600px the figures sit in one
// row like a phone row, an arrow in each gap; below that they go 2 per row and the
// arrows drop out, since a wrapped row would point them the wrong way. The list and
// the numbered captions carry the order either way.
import Figure from './Figure.astro';
import type { Frame } from '../lib/case-study/layouts';
import type { Block } from '../lib/case-study/parse';

interface Props {
	run: Extract<Block, { kind: 'figures' }>;
	frame: Frame;
}

const { run, frame } = Astro.props;
const count = run.items.length;
const sizes =
	frame === 'phone'
		? `(min-width: 1200px) 240px, (min-width: 600px) ${Math.round(100 / count)}vw, 45vw`
		: `(min-width: 1248px) ${Math.round(1200 / count)}px, (min-width: 600px) ${Math.round(100 / count)}vw, 45vw`;
const Tag = run.caption ? 'figure' : 'div';
---

<Tag class:list={['step-row', `step-row--${frame}`]} style={`--count: ${count}`}>
	<ol class="step-row__list" role="list">
		{
			run.items.map((item) => (
				<li class="step-row__step">
					<Figure figure={item} frame={frame} sizes={sizes} />
				</li>
			))
		}
	</ol>
	{run.caption && <figcaption class="step-row__caption" set:html={run.caption} />}
</Tag>

<style>
	.step-row {
		display: grid;
		gap: var(--space-16);
	}

	.step-row__list {
		--gap-x: var(--space-16);

		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-32) var(--gap-x);
		padding: 0;
		list-style: none;
	}

	.step-row__step {
		position: relative;
		container-type: inline-size;
	}

	.step-row--phone .step-row__step {
		justify-self: center;
		inline-size: 100%;
		max-inline-size: 15rem;
	}

	/* An odd last step takes the full row, centred at one column's width. */
	.step-row__step:last-child:nth-child(odd) {
		grid-column: 1 / -1;
		justify-self: center;
		inline-size: calc((100% - var(--gap-x)) / 2);
	}

	/* The label is the step itself, so it reads as text, not a muted caption. */
	.step-row__step :global(.figure__caption) {
		color: var(--color-text);
		font-weight: var(--weight-semibold);
	}

	.step-row__caption {
		color: var(--color-text-muted);
		font-size: var(--text-14);
		text-align: center;
	}

	@media (min-width: 600px) {
		.step-row__list {
			--gap-x: var(--space-48);

			grid-template-columns: repeat(var(--count), minmax(0, 15rem));
			justify-content: center;
		}

		.step-row:not(.step-row--phone) .step-row__list {
			grid-template-columns: repeat(var(--count), minmax(0, 1fr));
		}

		.step-row__step:last-child:nth-child(odd) {
			grid-column: auto;
			inline-size: 100%;
		}

		/* Centred in the gap, level with the middle of a phone (about 2.1 times its width tall). */
		.step-row__step:not(:last-child)::after {
			content: '→' / '';
			position: absolute;
			inset-block-start: calc(100cqi * 1.06);
			inset-inline-start: 100%;
			inline-size: var(--gap-x);
			color: var(--color-text-muted);
			font-size: var(--text-24);
			line-height: 1;
			text-align: center;
			transform: translateY(-50%);
		}

		.step-row:not(.step-row--phone) .step-row__step:not(:last-child)::after {
			inset-block-start: 50%;
		}
	}
</style>
