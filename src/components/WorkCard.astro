---
// One case study on the home grid: its cover, then the project name, card line and
// outcome as plain text. Below 600px the card is a row (cover left, text right); from
// 600px the text sits under the cover. The link's name is the project name; its
// description, not shown, is the outcome and then the summary.
import type { CollectionEntry } from 'astro:content';
import WorkCover from './WorkCover.astro';

interface Props {
	entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { title, summary, card_line, glance } = entry.data;
const outcome = glance?.outcome;
// The card shows the project name: the part of the title before the colon.
const name = title.split(':')[0].trim();
const id = `work-card-${entry.id}`;
---

<a
	class="work-card"
	href={`/work/${entry.id}`}
	aria-labelledby={`${id}-title`}
	aria-describedby={`${id}-summary`}
>
	<WorkCover data={entry.data} />
	<div class="work-card__text">
		<h3 id={`${id}-title`} class="work-card__title">{name}</h3>
		{card_line && <p class="work-card__line" aria-hidden="true">{card_line}</p>}
		{
			outcome && (
				<p class="work-card__outcome" aria-hidden="true">
					<span class="work-card__outcome-label">Outcome</span>
					{outcome}
				</p>
			)
		}
	</div>
	<p id={`${id}-summary`} class="visually-hidden">
		{outcome && `Outcome: ${outcome} `}
		{summary}
	</p>
</a>

<style>
	.work-card {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		gap: var(--space-16);
		align-items: center;
		color: var(--color-text);
		text-decoration: none;
	}

	.work-card__text {
		display: grid;
		gap: var(--space-4);
		min-inline-size: 0;
	}

	/* 16px keeps the longest name, PLANETSTEWARDS, on one line at 360px. */
	.work-card__title {
		font-family: var(--font-display);
		font-size: var(--text-16);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-heading);
		overflow-wrap: break-word;
	}

	.work-card__line {
		color: var(--color-text-muted);
		font-size: var(--text-14);
		line-height: var(--leading-heading);
	}

	/* The label stacks above the outcome so the line gets the column's full width. One
	   accent square is the card's only colour. Screen readers get the outcome from the
	   description instead, as plain "Outcome: …" text. */
	.work-card__outcome {
		margin-block-start: var(--space-4);
		font-size: var(--text-14);
		line-height: var(--leading-heading);
	}

	.work-card__outcome-label {
		display: block;
		margin-block-end: var(--space-4);
		color: var(--color-text-muted);
		font-size: var(--text-14);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.work-card__outcome-label::before {
		content: '';
		display: inline-block;
		inline-size: 0.5rem;
		block-size: 0.5rem;
		margin-inline-end: 0.375rem;
		vertical-align: 0.05em;
		background-color: var(--color-accent);
	}

	@media (min-width: 600px) {
		.work-card {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-12);
			align-content: start;
		}
	}

	@media (min-width: 768px) {
		.work-card__title {
			font-size: var(--text-18);
		}
	}

	/* Hover underlines the name and, where motion is welcome, lifts the frame. Touch
	   screens get neither. */
	@media (hover: hover) {
		.work-card:hover .work-card__title {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.work-card:hover :global(.work-cover > *) {
			transform: translateY(calc(var(--space-4) * -1.5));
		}
	}
</style>
