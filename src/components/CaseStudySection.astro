---
// One ## section of a case study, laid out by its layout note.
import CaseStudyBlocks from './CaseStudyBlocks.astro';
import ChapterHeader from './ChapterHeader.astro';
import Figure from './Figure.astro';
import FigureGrid from './FigureGrid.astro';
import LabelledStack from './LabelledStack.astro';
import PhonesThenBrowser from './PhonesThenBrowser.astro';
import SplitBlocks from './SplitBlocks.astro';
import StageRows from './StageRows.astro';
import StepRow from './StepRow.astro';
import type { Frame, Layout } from '../lib/case-study/layouts';
import type { Block, Section, Subsection } from '../lib/case-study/parse';

interface Props {
	section: Section;
	/** The section's place on the page, for its numbered label (the overview is 01). */
	number: number;
}

type Run = Extract<Block, { kind: 'figures' }>;

const { section, number } = Astro.props;
const layout: Layout = section.layout ?? { kind: 'stack' };

const frameFor = (own: Layout | undefined, fallback: Frame): Frame =>
	own?.kind === 'row' ? own.frame : own?.kind === 'rows' ? 'none' : fallback;
const sectionFrame: Frame = layout.kind === 'headline-row' ? 'phone' : frameFor(layout, 'none');
const uniform = (own: Layout | undefined) => own?.kind === 'row' && own.uniform;

const prose = section.blocks.filter((block) => block.kind !== 'figures');
const figures = section.blocks.filter((block): block is Run => block.kind === 'figures');
const needsOneRun = (note: string, min: number): Run => {
	if (figures.length !== 1 || figures[0].items.length < min) {
		throw new Error(`"${section.heading}": "${note}" needs exactly one run of at least ${min} images`);
	}
	return figures[0];
};

const run =
	layout.kind === 'phones-then-browser'
		? needsOneRun('row of phones, then full-width browser screenshot', 2)
		: layout.kind === 'headline-desktop-phones'
			? needsOneRun('desktop view next to body and a row of phones under', 2)
			: layout.kind === 'two-column'
				? needsOneRun('two columns', 2)
				: layout.kind === 'steps'
					? needsOneRun('phones in a row with numbered step labels and arrows', 2)
					: undefined;
const [lead, ...others] = run?.items ?? [];

// The sitemap layout draws its subsection (the shipped navigation) in its own right-hand column.
if (layout.kind === 'sitemap-nav' && (figures.length !== 1 || section.subsections.length !== 1)) {
	throw new Error(`"${section.heading}": the sitemap layout needs one sitemap image and one navigation subsection`);
}

const subsectionRuns = (sub: Subsection): Run => {
	const runs = sub.blocks.filter((block): block is Run => block.kind === 'figures');
	if (runs.length !== 1) throw new Error(`"${sub.heading}": a labelled stack needs exactly one run of images`);
	return runs[0];
};

// "Three posters in a row, then two LED screens in a row": the runs must hold those counts, in order.
for (const part of [section, ...section.subsections]) {
	if (part.layout?.kind !== 'rows') continue;
	const counts = part.blocks.filter((block): block is Run => block.kind === 'figures').map((r) => r.items.length);
	if (counts.join() !== part.layout.counts.join()) {
		throw new Error(`"${part.heading}": the layout note needs rows of ${part.layout.counts.join(', ')} images, got ${counts.join(', ') || 'none'}`);
	}
}

// Stat cards: a line above them is their source, in small muted type; a line after them is body.
const statsAt = prose.findIndex((block) => block.kind === 'stats');
const statsBefore = statsAt === -1 ? [] : prose.slice(0, statsAt).filter((block) => block.kind === 'prose');
const statsAfter = statsAt === -1 ? [] : prose.slice(statsAt + 1).filter((block) => block.kind === 'prose');

const subsectionClass = (sub: Subsection) => [
	'cs-subsection',
	{ 'cs-subsection--headline': layout.kind === 'headline-row' },
	{ 'cs-subsection--swatches': sub.layout?.kind === 'swatches' },
];
---

{
	layout.kind === 'stages' ? (
		<StageRows section={section} number={number} />
	) : (
		<section class:list={['cs-section', 'container', 'container-rule', `cs-section--${layout.kind}`]} aria-labelledby={section.id}>
			<ChapterHeader
				class="cs-section__header"
				number={number}
				id={section.id}
				heading={section.heading}
				subhead={section.subhead}
				small={layout.kind === 'headline-row'}
			/>
			{layout.kind === 'split' ? (
				<SplitBlocks blocks={section.blocks} frame={layout.frame} />
			) : layout.kind === 'phones-then-browser' && run ? (
				<>
					<CaseStudyBlocks blocks={prose} />
					<PhonesThenBrowser run={run} />
				</>
			) : layout.kind === 'headline-desktop-phones' && run ? (
				<>
					<div class="cs-desktop">
						<CaseStudyBlocks blocks={prose} />
						<Figure figure={lead} frame="browser" sizes="(min-width: 1800px) 788px, (min-width: 1200px) 45vw, 100vw" />
					</div>
					<FigureGrid items={others} frame="phone" />
				</>
			) : layout.kind === 'steps' && run ? (
				<>
					<StepRow run={run} frame={layout.frame} />
					<CaseStudyBlocks blocks={prose} />
				</>
			) : layout.kind === 'two-column' && run ? (
				<div class="cs-columns">
					<div class="cs-columns__column">
						<CaseStudyBlocks blocks={prose} />
						<Figure figure={lead} frame="browser" sizes="(min-width: 1800px) 788px, (min-width: 1200px) 45vw, 100vw" />
					</div>
					<div class="cs-columns__column">
						{others.map((figure) => (
							<Figure figure={figure} frame="browser" sizes="(min-width: 1800px) 788px, (min-width: 1200px) 45vw, 100vw" />
						))}
					</div>
				</div>
			) : layout.kind === 'stats' ? (
				<>
					{statsBefore.length > 0 && (
						<div class="cs-stats__source">
							<CaseStudyBlocks blocks={statsBefore} />
						</div>
					)}
					<CaseStudyBlocks blocks={prose.filter((block) => block.kind === 'stats')} />
					<CaseStudyBlocks blocks={statsAfter} />
				</>
			) : layout.kind === 'sitemap-nav' ? (
				<>
					<CaseStudyBlocks blocks={prose} />
					<div class="cs-sitemap">
						<CaseStudyBlocks blocks={figures} columns={1} />
						{section.subsections.map((sub) => (
							<section class="cs-subsection" aria-labelledby={sub.id}>
								<h3 id={sub.id} class="cs-subsection__title">
									{sub.heading}
								</h3>
								<CaseStudyBlocks blocks={sub.blocks} />
							</section>
						))}
					</div>
				</>
			) : (
				<CaseStudyBlocks
					blocks={section.blocks}
					frame={sectionFrame}
					columns={layout.kind === 'full' ? 1 : undefined}
					uniform={uniform(layout)}
				/>
			)}
			{layout.kind !== 'sitemap-nav' &&
				section.subsections.map((sub) => (
					<section class:list={subsectionClass(sub)} aria-labelledby={sub.id}>
						<h3 id={sub.id} class="cs-subsection__title">
							{sub.heading}
						</h3>
						{sub.layout?.kind === 'split' ? (
							<SplitBlocks blocks={sub.blocks} frame={sub.layout.frame} />
						) : sub.layout?.kind === 'labelled-stack' ? (
							<>
								<CaseStudyBlocks blocks={sub.blocks.filter((block) => block.kind !== 'figures')} />
								<LabelledStack labels={sub.layout.labels} run={subsectionRuns(sub)} />
							</>
						) : (
							<CaseStudyBlocks blocks={sub.blocks} frame={frameFor(sub.layout, sectionFrame)} uniform={uniform(sub.layout)} />
						)}
					</section>
				))}
		</section>
	)
}

<style>
	/* Phones get a tighter rhythm, so a skim reaches Results sooner; from 600px it
	   opens up to 48px sections and 32px blocks. */
	.cs-section {
		--section-gap: var(--space-24);

		display: grid;
		gap: var(--section-gap);
		padding-block: var(--space-32);
	}

	/* A hairline (.container-rule), then the chapter header (ChapterHeader), 16px above its
	   own content; the grid gap still spaces the blocks. */
	.cs-section__header {
		margin-block-end: calc(var(--space-16) - var(--section-gap));
	}

	.cs-subsection {
		display: grid;
		gap: var(--space-24);
	}

	.cs-subsection__title {
		margin-block-end: calc(var(--space-16) - var(--space-24));
		font-size: var(--text-24);
	}

	/* "One headline, body below": the subsection heading is the section's headline. */
	.cs-subsection--headline {
		gap: var(--space-32);
	}

	.cs-subsection--headline .cs-subsection__title {
		max-inline-size: 18ch;
		font-size: var(--text-display);
	}

	/* Logo and other uniform rows stay small: a mark doesn't need the full width. */
	.cs-subsection :global(.figure-grid--uniform) {
		max-inline-size: 48rem;
	}

	.cs-desktop,
	.cs-columns,
	.cs-columns__column,
	.cs-sitemap {
		display: grid;
		gap: var(--space-32);
		align-content: start;
	}

	.cs-stats__source :global(.prose) {
		color: var(--color-text-muted);
		font-size: var(--text-14);
	}

	@media (min-width: 600px) {
		.cs-section {
			--section-gap: var(--space-32);

			padding-block: var(--space-48);
		}
	}

	@media (min-width: 1200px) {
		.cs-section {
			padding-block: var(--space-64);
		}

		/* Splits sit on the page's twelve columns, an empty column between the parts where
		   they are unequal: 5 | 6, 6 | 6, 7 | 4. */
		.cs-desktop,
		.cs-columns,
		.cs-sitemap {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			gap: var(--space-48) var(--gutter);
			align-items: start;
		}

		.cs-desktop > :global(:first-child) {
			grid-column: span 5;
		}

		.cs-desktop > :global(:last-child) {
			grid-column: 7 / -1;
		}

		.cs-columns > :global(*) {
			grid-column: span 6;
		}

		.cs-sitemap > :global(:first-child) {
			grid-column: span 7;
		}

		.cs-sitemap > :global(:last-child) {
			grid-column: 9 / -1;
		}
	}
</style>
