---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ogImageFor } from '../../lib/og';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import OtherWorkSection from '../../components/OtherWorkSection.astro';
import OtherWorksHero from '../../components/OtherWorksHero.astro';
import OtherWorksPager from '../../components/OtherWorksPager.astro';
import { parseOtherWork } from '../../lib/case-study/parse';
import { compositions, layoutFor } from '../../lib/other-works/compositions';

export async function getStaticPaths() {
	// Other works with a composition. The next link comes from every other work, so it
	// already points at the full set.
	const entries = (await getCollection('otherWorks')).sort((a, b) => a.data.order - b.data.order);
	const next = (i: number) => entries[(i + 1) % entries.length];
	return entries.flatMap((entry, i) =>
		entry.id in compositions ? [{ params: { slug: entry.id }, props: { entry, next: next(i) } }] : [],
	);
}

interface Props {
	entry: CollectionEntry<'otherWorks'>;
	next: CollectionEntry<'otherWorks'>;
}

const { entry, next } = Astro.props;
const { title, summary } = entry.data;
const composition = compositions[entry.id];
const [overview, ...sections] = parseOtherWork(entry.id, entry.body ?? '');
if (overview?.heading !== 'Overview') {
	throw new Error(`other-works/${entry.id}/index.md: the first section needs to be ## Overview`);
}
const og = ogImageFor(entry.id, entry.data.cover_alt);
---

<BaseLayout title={`${title} | Ismail Azry`} description={summary} ogImage={og}>
	<div class:list={['other-work', { inverse: composition.theme === 'inverse' }]}>
		<article>
			<OtherWorksHero entry={entry} overview={overview} variant={composition.hero} />
			{sections.map((section) => <OtherWorkSection section={section} layout={layoutFor(composition, entry.id, section.id)} />)}
		</article>
		<OtherWorksPager next={next} />
	</div>
	<Lightbox />
</BaseLayout>
