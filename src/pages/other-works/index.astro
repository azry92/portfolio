---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OtherWorkRow from '../../components/OtherWorkRow.astro';
import { work } from '../../data/site';

const entries = (await getCollection('otherWorks')).sort((a, b) => a.data.order - b.data.order);
const heading = work.more.find((item) => item.href === '/other-works')!.label;
const description = `${heading} by Ismail Azry: ${entries.map((entry) => entry.data.title).join(' and ')}.`;
---

<BaseLayout title={`${heading} | Ismail Azry`} description={description}>
	<div class="other-works container">
		<h1 class="other-works__title">{heading}</h1>
		<ul class="other-works__list" role="list">
			{
				entries.map((entry, i) => (
					<li>
						<OtherWorkRow entry={entry} priority={i === 0} />
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.other-works {
		display: grid;
		gap: var(--space-32);
		padding-block: var(--space-48) var(--space-32);
	}

	.other-works__title {
		font-size: var(--text-display);
	}

	.other-works__list {
		display: grid;
		padding: 0;
		list-style: none;
	}

	/* A hairline between projects, none above the first. */
	.other-works__list > li + li {
		margin-block-start: var(--space-32);
		padding-block-start: var(--space-32);
		border-block-start: var(--border-width) solid var(--color-border);
	}

	@media (min-width: 600px) {
		.other-works {
			gap: var(--space-48);
			padding-block-start: var(--space-64);
		}

		.other-works__list > li + li {
			margin-block-start: var(--space-48);
			padding-block-start: var(--space-48);
		}
	}
</style>
