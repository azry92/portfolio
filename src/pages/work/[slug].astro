---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import Prose from '../../components/Prose.astro';
import { readableOn } from '../../lib/case-study/contrast';
import { parseCaseStudy } from '../../lib/case-study/parse';

export async function getStaticPaths() {
	// Case studies whose layout notes the template can draw. The others join as
	// their own steps add the layouts they need. (getStaticPaths is hoisted, so this lives inside it.)
	const READY = new Set(['at-auto-shoppe']);
	const entries = await getCollection('caseStudies');
	return entries.filter((entry) => READY.has(entry.id)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
	entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { title, summary, accent } = entry.data;
const [overview, ...sections] = parseCaseStudy(entry.id, entry.body ?? '');
if (overview?.layout?.kind !== 'hero') {
	throw new Error(`case-studies/${entry.id}/index.md: the first section needs the hero layout note`);
}

// Text on the accent band: cream where it reaches AA, otherwise white.
const onAccent = accent
	? readableOn(accent, [
			['--color-text-inverse', '#f0eee9'],
			['--color-surface', '#ffffff'],
		])
	: undefined;
const accentStyle = accent ? `--accent: ${accent}; --on-accent: var(${onAccent})` : undefined;
---

<BaseLayout title={`${title} | Ismail Azry`} description={summary}>
	<article class="case-study" style={accentStyle}>
		<CaseStudyHero entry={entry} overview={overview} />
		{
			sections.map((section) => (
				<section aria-labelledby={section.id}>
					<h2 id={section.id}>{section.heading}</h2>
					{section.blocks.map((block) => block.kind === 'prose' && <Prose html={block.html} />)}
					{section.subsections.map((sub) => (
						<>
							<h3 id={sub.id}>{sub.heading}</h3>
							{sub.blocks.map((block) => block.kind === 'prose' && <Prose html={block.html} />)}
						</>
					))}
				</section>
			))
		}
	</article>
</BaseLayout>
