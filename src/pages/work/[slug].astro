---
import { getImage } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import CaseStudyPager from '../../components/CaseStudyPager.astro';
import CaseStudySection from '../../components/CaseStudySection.astro';
import Lightbox from '../../components/Lightbox.astro';
import { readableOn } from '../../lib/case-study/contrast';
import { parseCaseStudy } from '../../lib/case-study/parse';

export async function getStaticPaths() {
	// Case studies whose layout notes the template can draw. The others join as
	// their own steps add the layouts they need. (getStaticPaths is hoisted, so this lives inside it.)
	const READY = new Set(['at-auto-shoppe', 'planetstewards', 'precious-wedding']);
	const entries = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
	// Neighbours come from every case study, so the pager already points at the full set.
	const at = (i: number) => entries[(i + entries.length) % entries.length];
	return entries.flatMap((entry, i) =>
		READY.has(entry.id) ? [{ params: { slug: entry.id }, props: { entry, prev: at(i - 1), next: at(i + 1) } }] : [],
	);
}

interface Props {
	entry: CollectionEntry<'caseStudies'>;
	prev: CollectionEntry<'caseStudies'>;
	next: CollectionEntry<'caseStudies'>;
}

const { entry, prev, next } = Astro.props;
const { title, summary, accent } = entry.data;
const [overview, ...sections] = parseCaseStudy(entry.id, entry.body ?? '');
if (overview?.layout?.kind !== 'hero') {
	throw new Error(`case-studies/${entry.id}/index.md: the first section needs the hero layout note`);
}
const resultsId = sections.find((section) => section.heading === 'Results')?.id;

// Text on the accent band: white where it reaches AA, otherwise cream.
const onAccent = accent
	? readableOn(accent, [
			['--color-surface', '#ffffff'],
			['--color-text-inverse', '#f0eee9'],
		])
	: undefined;
const accentStyle = accent ? `--accent: ${accent}; --on-accent: var(${onAccent})` : undefined;
const ogImage = await getImage({ src: entry.data.cover, width: 1200, format: 'png' });
---

<BaseLayout title={`${title} | Ismail Azry`} description={summary} ogImage={ogImage.src}>
	<div class="case-study" style={accentStyle}>
		<article>
			<CaseStudyHero entry={entry} overview={overview} resultsId={resultsId} />
			{sections.map((section) => <CaseStudySection section={section} />)}
		</article>
		<CaseStudyPager prev={prev} next={next} />
	</div>
	<Lightbox />
</BaseLayout>
