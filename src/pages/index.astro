---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import WorkGrid from '../components/WorkGrid.astro';
import GlyphBand from '../components/GlyphBand.astro';
import AboutSection from '../components/AboutSection.astro';
---

<BaseLayout showBackToTop={false} showFooterNav={false} fullWidth>
	<HomeHero />
	<div class="container container--full">
		<WorkGrid />
	</div>
	<!-- The animated band divides Selected work from About; About's own top padding sets the gap below it. -->
	<div class="home__band">
		<GlyphBand />
	</div>
	<div class="container container--full">
		<AboutSection number={2} />
	</div>
</BaseLayout>

<style>
	.home__band {
		margin-block-start: var(--space-48);
	}

	@media (min-width: 600px) {
		.home__band {
			margin-block-start: var(--space-64);
		}
	}
</style>
