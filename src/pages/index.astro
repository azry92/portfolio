---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import WorkGrid from '../components/WorkGrid.astro';
import LabSection from '../components/LabSection.astro';
import GlyphBand from '../components/GlyphBand.astro';
import AboutSection from '../components/AboutSection.astro';
---

<BaseLayout showBackToTop={false} showFooterNav={false} fullWidth>
	<HomeHero />
	<div class="container container--full">
		<WorkGrid />
	</div>
	<LabSection number={2} />
	<!-- The band sits flush under the red Lab section and hands over to About, whose own top
	     padding sets the gap below it. -->
	<GlyphBand />
	<div class="container container--full">
		<AboutSection number={3} />
	</div>
</BaseLayout>
